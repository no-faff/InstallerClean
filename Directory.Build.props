<Project>
  <PropertyGroup>
    <!-- Single source of truth for the product version.
         InstallerClean.csproj picks this up via <Version> inheritance,
         and the release script reads it from here to pass /DAppVersion
         to the Inno Setup compiler, so the installer never drifts from
         the assembly. -->
    <Version>3.7.0</Version>
    <!-- Right-click, Properties, Details is a surface cautious Windows users
         actually open on an unsigned binary, and a blank Copyright beside a
         populated Company is the shape of a repacked one. Company comes free
         from <Authors>; this is the field that was empty on both exes people
         run. No year, deliberately: an assembly attribute is baked at build
         time, where the setup's own AppCopyright is a compile-time expression
         (installer/InstallerClean.iss reads the clock), so a year here would
         freeze at whenever the release happened to be cut and then go stale
         wherever the exe is inspected. -->
    <Copyright>(c) No Faff</Copyright>
    <Deterministic>true</Deterministic>
    <!-- Every assembly is built for x64, so each copy runs as a 64-bit
         process: it reads the 64-bit registry view and the real System32,
         and every structure passed to Windows has its 64-bit layout. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- On Windows the SDK infers RuntimeIdentifier win-x64 for a .NET
         Framework exe from PlatformTarget, and on Linux it infers none.
         Declaring the RID here makes every restore on either OS compute
         the same graph, so packages.lock.json holds one shape whichever
         machine wrote it, and the locked restore passes on both. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Source-built SDKs (the Fedora dotnet RPM) ship their own
         rebuilt copies of SDK packages in a library-packs folder and
         add it as an implicit restore source; those rebuilds are
         byte-different from nuget.org's, so a lock file written from
         one fails NU1403 hash validation everywhere else. Restores
         must always source from nuget.org. No effect on Windows,
         whose SDK has no such folder. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>
  <ItemGroup>
    <!-- The .NET Framework 4.8 reference assemblies the compiler builds
         against, from nuget.org. The SDK adds this package by itself only
         where no 4.8 targeting pack is installed, which differs from one
         Windows machine to the next and is always the case on Linux;
         referenced here, it is in every restore graph and every build
         compiles against the same assemblies. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- A source generator, used at compile time only. It adds to each
         assembly, as internal types, the attributes the C# compiler needs
         for init accessors, required members, module initialisers and the
         nullable-analysis annotations, which .NET Framework 4.8 does not
         define. No PolySharp assembly ships. -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
