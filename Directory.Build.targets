<Project>
  <!-- An exe published without its own .NET, the slim among them, has written into it
       that it finds .NET only at the location .NET's installer registers, or in .NET's
       default install folder where none is registered. Neither the folder the exe is run
       from nor a folder named by DOTNET_ROOT or DOTNET_ROOT_X64 is searched, so a
       hostfxr.dll saved beside a downloaded copy, or in a folder the environment names,
       is not loaded. A self-contained publish that is not single file keeps its own
       hostfxr.dll beside its exe and needs that folder searched, so a publish with
       SelfContained true keeps the default search. This file is read after the publish
       profile and after the SDK has set SelfContained from PublishSelfContained and the
       other publish settings; set in a project file, the condition would be read before
       both and could put the setting on a self-contained publish. The SDK rebuilds the
       exe a publish writes into obj only when the assembly or the apphost changes, so a
       change to the value reaches a local publish after the obj folder is cleaned. -->
  <PropertyGroup Condition="'$(SelfContained)' != 'true'">
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
  </PropertyGroup>

  <!-- ONE FILE PER COPY. .NET Framework has no single-file publish, so a build
       given -p:OneFile=true merges each exe with every assembly it references
       that is not part of .NET Framework: InstallerClean.Core and the packages.
       The merged exe is written to publish/window or publish/cli at the root of
       the repository, or to the folder OneFileDir names, and is the whole copy:
       it loads no assembly from the folder it is run from.

       The exe the project built is the first input, so the merged file is that
       exe with the other assemblies' types added. It keeps the exe's own
       manifest, icon, version resource and assembly attributes, the
       TargetFrameworkAttribute among them, which is where .NET Framework reads
       the version an exe was built for; and it is the image Windows starts, as
       SystemLibraries.IsProcessImage requires. The symbols of every input are
       merged into the PDB embedded in the output.

       ILRepack runs on the dotnet host on every OS, so one engine does the merge
       wherever the build runs. /lib names the reference assemblies the build
       compiled against, which is where the tool resolves .NET Framework's own
       types. ILRepack writes a merged .exe.config beside the output, keeping the
       build's supportedRuntime line and dropping the binding redirects, whose
       assemblies are now inside the exe. /noRepackRes leaves out the tool's list
       of what it merged.

       The arguments go in a response file, one per line, rather than on the
       command line: a /lib folder ends in a separator, which on Windows is a
       backslash, and a backslash before the closing quote of a command-line
       argument is read as a literal quote. A response file takes each line whole,
       so no argument is quoted and none is split.

       Inputs and Outputs skip the merge when the output is newer than the built
       exe and every assembly it merges, so a rebuild that changed nothing does
       not merge again, and two project instances with the same inputs do not both
       write the output.

       Do not merge a Debug build: it compiles the Debug-only switches in. -->
  <PropertyGroup Condition="'$(OneFile)' == 'true' And '$(OneFileDir)' == ''">
    <OneFileDir Condition="'$(MSBuildProjectName)' == 'InstallerClean'">$(MSBuildThisFileDirectory)publish/window/</OneFileDir>
    <OneFileDir Condition="'$(MSBuildProjectName)' == 'InstallerClean.Cli'">$(MSBuildThisFileDirectory)publish/cli/</OneFileDir>
  </PropertyGroup>

  <Target Name="MergeToOneFile" AfterTargets="Build"
          Condition="'$(OneFile)' == 'true' And ('$(MSBuildProjectName)' == 'InstallerClean' Or '$(MSBuildProjectName)' == 'InstallerClean.Cli')"
          Inputs="$(TargetPath);@(ReferenceCopyLocalPaths)"
          Outputs="$([MSBuild]::EnsureTrailingSlash('$(OneFileDir)'))$(TargetFileName)">
    <ItemGroup>
      <_OneFileInput Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <_OneFileInCultureFolder Include="@(_OneFileInput)" Condition="'%(_OneFileInput.DestinationSubDirectory)' != ''" />
      <_OneFileLibFolder Include="$(TargetFrameworkDirectory)" />
    </ItemGroup>
    <PropertyGroup>
      <_OneFileOut>$([MSBuild]::EnsureTrailingSlash('$(OneFileDir)'))$(TargetFileName)</_OneFileOut>
      <_OneFileRsp>$(IntermediateOutputPath)onefile.rsp</_OneFileRsp>
    </PropertyGroup>
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="OneFile merges a Release build only; this build's configuration is $(Configuration)." />
    <Error Condition="'$(ILRepack)' == '' Or !Exists('$(ILRepack)')"
           Text="The ILRepack package is not restored, so there is nothing to merge with (ILRepack property: '$(ILRepack)')." />
    <Error Condition="'@(_OneFileInput)' == ''"
           Text="The build lists no referenced assembly to merge into $(TargetFileName)." />
    <Error Condition="'@(_OneFileInCultureFolder)' != ''"
           Text="A referenced assembly is built into a folder of its own and would be left out of the one file: @(_OneFileInCultureFolder)" />
    <Error Condition="'@(_OneFileLibFolder)' == ''"
           Text="The build names no reference-assembly folder for the merge to resolve .NET Framework's types from." />
    <ItemGroup>
      <_OneFileArg Include="/noRepackRes" />
      <_OneFileArg Include="/out:$(_OneFileOut)" />
      <_OneFileArg Include="@(_OneFileLibFolder->'/lib:%(Identity)')" />
      <_OneFileArg Include="$(TargetPath)" />
      <_OneFileArg Include="@(_OneFileInput->'%(FullPath)')" />
    </ItemGroup>
    <MakeDir Directories="$(OneFileDir)" />
    <Delete Files="$(_OneFileOut)" />
    <WriteLinesToFile File="$(_OneFileRsp)" Lines="@(_OneFileArg)" Overwrite="true" />
    <Exec Command="dotnet &quot;$(ILRepack)&quot; &quot;@$(_OneFileRsp)&quot;" />
    <Error Condition="!Exists('$(_OneFileOut)')" Text="The merge wrote no $(_OneFileOut)." />
    <Message Importance="high" Text="$(TargetFileName) and @(_OneFileInput->Count()) assemblies -> $(_OneFileOut)" />
  </Target>

</Project>
