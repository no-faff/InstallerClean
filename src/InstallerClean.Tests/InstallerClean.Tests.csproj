<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Pin test-package versions in packages.lock.json so test
         dependency drift can't mask production behaviour. The three
         shipping projects already do this; without it on Tests the
         versions of xunit / NSubstitute / coverlet floated and a
         minor-version refresh could change assertion semantics
         silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- MockFileSystem for unit tests against an in-memory filesystem. -->
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference both production projects directly. The tests need
         Core for the headless surface (Models, Services, Helpers,
         Interop) and the WPF assembly for MainViewModel and the
         GUI-only services. Listing both makes the dependency graph
         explicit; otherwise Core would only flow in transitively. -->
    <ProjectReference Include="..\InstallerClean.Core\InstallerClean.Core.csproj" />
    <ProjectReference Include="..\InstallerClean\InstallerClean.csproj" />
    <!-- And the command-line host, whose own helpers decide what a stopped or
         held-back /d or /m reports to the Application log a monitoring tool
         reads. Without this reference nothing in the suite could see that
         surface, so a defect in it could only be found by hand. It has a second
         effect worth having: a change that breaks the CLI now fails a build of
         this project instead of surviving to CI. -->
    <ProjectReference Include="..\InstallerClean.Cli\InstallerClean.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw XAML sources for the tests under Themes\, which assert the
         theme's cross-file ties: numeric ones XAML cannot express and a
         build cannot check (scrollbar end insets against the card radius,
         scrollbar margins against the list bleed), the composited contrast
         of a token against the surfaces it is drawn on, and the order of
         two control-template triggers, where the wrong order is valid XAML
         that simply looks wrong on screen. Embedded as plain bytes, not
         compiled: this project has no UseWPF, so no Page processing
         applies. -->
    <EmbeddedResource Include="..\InstallerClean\Themes\Primitives.xaml" LogicalName="ThemeXaml.Primitives.xaml" />
    <EmbeddedResource Include="..\InstallerClean\Themes\Tokens.xaml" LogicalName="ThemeXaml.Tokens.xaml" />
    <EmbeddedResource Include="..\InstallerClean\Themes\Components.xaml" LogicalName="ThemeXaml.Components.xaml" />
    <EmbeddedResource Include="..\InstallerClean\OrphanedFilesWindow.xaml" LogicalName="ThemeXaml.OrphanedFilesWindow.xaml" />
    <EmbeddedResource Include="..\InstallerClean\RegisteredFilesWindow.xaml" LogicalName="ThemeXaml.RegisteredFilesWindow.xaml" />
    <EmbeddedResource Include="..\InstallerClean\MainWindow.xaml" LogicalName="ThemeXaml.MainWindow.xaml" />
  </ItemGroup>

</Project>
