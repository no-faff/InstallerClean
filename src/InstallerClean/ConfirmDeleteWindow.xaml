<Window x:Class="InstallerClean.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:a11y="clr-namespace:InstallerClean.Helpers"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: this is a centred-on-owner modal with no
             title-bar buttons, so no drag region is needed and the
             Border below claims the full window. -->
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- Card width scales with the OS text size so the copy keeps its
         line length instead of wrapping into a tall sliver.

         Fixed at 440, min and max, which is measured rather than chosen: at
         420 the linked phrase splits across a line end, and at 460 and above
         the card goes ragged. The move dialog shares the 440 floor so the two
         match whenever their content is short. -->
    <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.ModalCard}" Padding="{StaticResource Padding.ModalCard}"
            MaxWidth="{a11y:TextScaled 440}" MinWidth="{a11y:TextScaled 440}"
            BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}">
        <!-- Grid, not a StackPanel: the body sits in a star row so it
             scrolls once the window's work-area MaxHeight binds (very
             large text scales), keeping the heading and the action
             buttons visible; a vertical StackPanel measures children at
             infinite height, so the buttons would clip instead. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- No warning icon: this is the normal, safe action InstallerClean
                 exists for, not a hazard to flag. The window behind states that
                 the files are safe to delete and this dialog repeats it, so an
                 alarm glyph would contradict both. Standalone wrapping
                 TextBlock so a long heading grows the SizeToContent card
                 instead of clipping. -->
            <TextBlock x:Name="MessageText" Grid.Row="0" Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                       TextWrapping="Wrap" Margin="{StaticResource GapBottom.Lg}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource BodyScrollRegion}"
                          AutomationProperties.Name="{loc:Translate Automation.Scroll.DialogBody}">
                <!-- Inlines composed in code-behind (BuildBodyLine) so the
                     bracketed phrase renders as a hyperlink into the README's
                     "Is it safe?" section; a TextBlock cannot bind Text and
                     host an inline Hyperlink at once, so there is no Text
                     binding here. This dialog carries its own link rather than
                     leaning on the main window's, because it is modal: that
                     one is visible behind it and cannot be clicked. -->
                <TextBlock x:Name="BodyText"
                           Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}" TextWrapping="Wrap"
                           Margin="{StaticResource GapBottom.Xl}"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel is the default to stop a reflexive Enter from
                     deleting; affirmative click requires explicit pointer
                     or Tab+Space. The help text describes the dialog's
                     choice: Cancel is the first focus, and help text is
                     only spoken for the focused element (a window-level
                     description is never read because the window never
                     has focus). -->
                <Button x:Name="CancelButton" Style="{StaticResource GhostPill}" Content="{loc:Translate Action.Cancel}"
                        Click="OnCancel" IsCancel="True" IsDefault="True"
                        AutomationProperties.HelpText="{loc:Translate Automation.ConfirmDelete}"
                        Margin="{StaticResource GapRight.Sm}"/>
                <!-- Accent, not DangerPill, and deliberately so. There is no
                     red anywhere on this path: the sentence directly above
                     says the files are safe to delete, and red would be the
                     one element arguing with it. DangerPill stays in the theme
                     unused. -->
                <Button x:Name="DeleteButton" Style="{StaticResource AccentPill}"
                        Content="{loc:Translate Action.DeletePermanently}" Click="OnDelete"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
