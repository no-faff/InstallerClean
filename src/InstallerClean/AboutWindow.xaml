<Window x:Class="InstallerClean.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:chrome="clr-namespace:InstallerClean.Controls"
        Title="{loc:Translate Window.About.Title}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Sidebar}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="{StaticResource Margin.DetailWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <!-- Version -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <!-- The three link lines (guide, issue tracker, licence) at a
                 tighter 6 apart: all three render as links, so they read as
                 one block of doors out to GitHub, and the wider gaps either
                 side separate that block from the version above and the
                 checkbox below. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <!-- Auto-update checkbox: last, and alone, because it is the
                 window's one control rather than another link. -->
            <RowDefinition Height="Auto"/>
            <!-- Star spacer: the gap before the say-thanks block. Under
                 SizeToContent="Height" it sits at MinHeight and expands past it
                 only in the arrange pass, when the content is shorter than the
                 window MinHeight (set in code-behind), taking up the slack to
                 pin the say-thanks block to the bottom, the airy box. The
                 MinHeight floor keeps a section gap above say-thanks if the
                 window ever grows to fit taller content (a large OS text
                 scale), rather than letting the spacer collapse to zero. -->
            <RowDefinition Height="*" MinHeight="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="-8,-4,0,0">
            <chrome:DecorativeImage Source="Assets/splash-icon.png" Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="{StaticResource GapRight.Sm}"/>
            <TextBlock Text="{loc:Translate Window.About.Title}" Foreground="{StaticResource Text.Body}"
                       FontSize="{StaticResource Type.TitleBar}" FontWeight="Medium"/>
        </StackPanel>
        <Button Grid.Row="0" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="{loc:Translate Tooltip.Close}"
                Click="CloseClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="{StaticResource Margin.CloseButtonOverhang}" AutomationProperties.Name="{loc:Translate Automation.CloseWindow}"/>

        <TextBlock Grid.Row="1" Text="{loc:Translate Window.Main.Title}"
                   Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Md}" FontWeight="SemiBold"/>

        <TextBox Grid.Row="3" x:Name="VersionText" HorizontalAlignment="Left"
                 Style="{StaticResource SelectableText}" Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                 VerticalAlignment="Center" Margin="-2,0,0,0"/>

        <!-- The guide link. Each supported language has its own README file,
             so the target is resolved in code-behind (ReadmeLinks.Home)
             against the language on screen rather than pinned here: it
             should not open on English for someone reading the window in
             Polish. The app's other two README links are both mid-sentence
             and both point at one section of it (the missing-file note, the
             completion screen's restore hint); this is the only one that
             offers the document itself. -->
        <TextBlock Grid.Row="5" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}">
            <Hyperlink x:Name="GuideLink"
                       Click="Hyperlink_Click"
                       Style="{StaticResource SubtleLink}"
                       AutomationProperties.HelpText="{loc:Translate Automation.About.Guide.HelpText}"><Run Text="{loc:Translate About.Link.Guide}"/></Hyperlink>
        </TextBlock>

        <TextBlock Grid.Row="7" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}">
            <Hyperlink NavigateUri="https://github.com/no-faff/InstallerClean/issues"
                       Click="Hyperlink_Click"
                       Style="{StaticResource SubtleLink}"
                       AutomationProperties.HelpText="{loc:Translate Automation.About.ReportProblem.HelpText}"><Run Text="{loc:Translate About.Link.ReportProblem}"/></Hyperlink>
        </TextBlock>

        <TextBlock Grid.Row="9" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}">
            <Hyperlink NavigateUri="https://github.com/no-faff/InstallerClean/blob/main/LICENSE"
                       Click="Hyperlink_Click"
                       Style="{StaticResource SubtleLink}"
                       AutomationProperties.Name="{loc:Translate Automation.Licence}"
                       AutomationProperties.HelpText="{loc:Translate Automation.Licence.HelpText}"><Run Text="{loc:Translate Action.Licence}"/></Hyperlink>
        </TextBlock>

        <!-- The off switch for the automatic once-per-session update check.
             Read when the check fires rather than at startup, so unticking
             it stops this session's check as well as every later one, and
             ticking it back on needs no restart.

             Checked/Unchecked are attached in code-behind, not here: the
             constructor's own assignment of IsChecked would otherwise fire
             the handler and write the setting back on every open. -->
        <CheckBox Grid.Row="11" x:Name="AutoUpdateCheckBox"
                  HorizontalAlignment="Left"
                  Content="{loc:Translate About.AutoUpdateCheck}"
                  AutomationProperties.HelpText="{loc:Translate Automation.AutoUpdateCheck.HelpText}"/>

        <!-- Section header above the Star + Buy-me-a-cuppa row. The
             resx value is already uppercased so screen readers don't
             see SmallCaps glyph mapping at all. Type.Heading.Sm +
             Text.Body matches MOVE LOCATION and the registered-
             window PRODUCTS / PATCHES / PRODUCT DETAILS labels. -->
        <TextBlock Grid.Row="13" Text="{loc:Translate Section.SayThanks}"
                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Heading.Sm}"
                   AutomationProperties.Name="{loc:Translate Automation.SayThanks}"/>

        <Grid Grid.Row="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource CompactGhostPill}"
                        Click="StarClick" AutomationProperties.Name="{loc:Translate Automation.LeaveStarOnGitHub.About}"
                        Margin="-12,0,0,0"
                        ToolTipService.InitialShowDelay="0">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource AccentTooltip}" Content="{loc:Translate Tooltip.LeaveStarOnGitHub.About}"/>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="m12.672.668 3.059 6.197 6.838.993a.75.75 0 0 1 .416 1.28l-4.948 4.823 1.168 6.812a.75.75 0 0 1-1.088.79L12 18.347l-6.116 3.216a.75.75 0 0 1-1.088-.791l1.168-6.811-4.948-4.823a.749.749 0 0 1 .416-1.279l6.838-.994L11.327.668a.75.75 0 0 1 1.345 0Z"
                              Fill="{StaticResource Decoration.Star}" Width="12" Height="12" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="{StaticResource GapRight.Icon}"/>
                        <AccessText Text="{loc:Translate Action.LeaveStarOnGitHub}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CompactGhostPill}"
                        Click="DonateClick" AutomationProperties.Name="{loc:Translate Automation.BuyMeACuppa.About}"
                        Margin="8,0,0,0"
                        ToolTipService.InitialShowDelay="0">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource AccentTooltip}" Content="{loc:Translate Tooltip.BuyMeACuppa.About}"/>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                              Fill="{StaticResource Decoration.Heart}" Width="12" Height="12" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="{StaticResource GapRight.Icon}"/>
                        <AccessText Text="{loc:Translate Action.BuyMeACuppa}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource CompactPill}"
                    Content="{loc:Translate Action.Close}" IsCancel="True"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{loc:Translate Automation.Close}"/>
        </Grid>
    </Grid>
</Window>
