<Window x:Class="InstallerClean.ConfirmMoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:a11y="clr-namespace:InstallerClean.Helpers"
        Title="{loc:Translate Window.ConfirmMove.Title}"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: this is a centred-on-owner modal with no
             title-bar buttons, so no drag region is needed and the
             Border below claims the full window. -->
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- Card width scales with the OS text size so the copy keeps its
         line length instead of wrapping into a tall sliver. -->
    <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Card}" Padding="{StaticResource Padding.ModalCard}"
            MaxWidth="{a11y:TextScaled 520}" MinWidth="{a11y:TextScaled 320}"
            BorderBrush="{StaticResource Action.Primary.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}">
        <!-- Grid, not a StackPanel: the destination (the one line that
             can run long) sits in a star row so it scrolls once the
             window's work-area MaxHeight binds (very large text scales),
             keeping the heading and the action buttons visible; a
             vertical StackPanel measures children at infinite height,
             so the buttons would clip instead. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="MessageText" Grid.Row="0" Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                       TextWrapping="Wrap" Margin="{StaticResource GapBottom.Sm}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource BodyScrollRegion}"
                          AutomationProperties.Name="{loc:Translate Automation.Scroll.DialogBody}">
                <StackPanel Margin="{StaticResource GapBottom.Lg}">
                    <TextBlock x:Name="DestinationLabel" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DestinationText" Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap" Margin="{StaticResource GapTop.Sm}"/>

                    <!-- Same-drive note. Shown only when the destination is on
                         the drive the files already sit on, where the move frees
                         no space until the parked copies are deleted. The amber
                         triangle is the app's established "this is not what you
                         may be expecting" marker (pending reboot, missing from
                         disk, bin unavailable). DockPanel, not a horizontal
                         StackPanel, so the sentence wraps: a StackPanel gives
                         its child infinite width and TextWrapping never engages. -->
                    <DockPanel x:Name="SameDriveNote" Visibility="Collapsed"
                               Margin="0,16,0,0">
                        <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                              Fill="{StaticResource Status.Warning}" Width="16" Height="16" Stretch="Uniform"
                              DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                        <TextBlock Text="{loc:Translate Confirm.MoveSameDrive}"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel is the default for symmetry with the Confirm
                     Delete dialog: a reflexive Enter dismisses, never
                     commits. The help text describes the dialog's choice
                     from the first focus, as on Confirm Delete. -->
                <Button x:Name="CancelButton" Style="{StaticResource GhostPill}" Content="{loc:Translate Action.Cancel}"
                        Click="OnCancel" IsCancel="True" IsDefault="True"
                        AutomationProperties.HelpText="{loc:Translate Automation.ConfirmMove}"
                        Margin="{StaticResource GapRight.Sm}"/>
                <Button Style="{StaticResource AccentPill}" Content="{loc:Translate Action.Move}"
                        Click="OnMove"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
