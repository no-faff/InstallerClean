<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- R2R is off by .NET 10 default for PublishSingleFile +
         framework-dependent; pinning here makes the absence explicit
         so a future SDK feature-band change to the default cannot
         silently flip the slim binary's R2R section count. R2R
         cold-start gains are negligible for a rarely-run utility and
         the section-count delta would be exactly the cumulative
         AV-signal shift the pre-tag VirusTotal step in the release
         runbook is meant to catch. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <RootNamespace>InstallerClean</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>InstallerClean</AssemblyName>
    <!-- Version comes from Directory.Build.props -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Description is what Windows shows as Comments, further down the same
         Details tab as File description below. It says what the app finds and
         what it does with them. The command line carries the same sentence; File
         description sits directly above this field and already marks which
         binary is which. -->
    <Description>Finds the MSI and MSP files in C:\Windows\Installer that no installed program still needs, and moves or deletes them.</Description>
    <!-- AssemblyTitle is what Windows shows as File description: Explorer's
         Details tab and Description column, and Task Manager's process list.
         Left unset it defaults to the assembly name, which repeats
         "InstallerClean" beside a file called InstallerClean.exe and tells a
         reader nothing. That reader is the one who opens Properties on an
         unsigned download before running it. Description above is a different
         field, Comments. -->
    <AssemblyTitle>Cleans up unneeded files in C:\Windows\Installer</AssemblyTitle>
    <!-- Product name on the same Details tab, two rows under File description.
         Unset it defaults to the assembly name, which reads correctly here and
         does so by accident: this assembly happens to be called InstallerClean.
         The command line's is called installerclean-cli, so the same default puts
         a file name in the row where a product name belongs. Stated in both
         projects rather than hoisted, because the pair either names one product
         or it does not, and the setup already writes the same value as
         VersionInfoProductName. One product, two hosts, three places that must
         agree. -->
    <Product>InstallerClean</Product>
    <Authors>No Faff</Authors>
    <RepositoryUrl>https://github.com/no-faff/InstallerClean</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- en-GB is the source-of-truth language; the neutral Strings.resx
         in InstallerClean.Core holds the source content. -->
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <!-- A Release build runs no start-up hook: neither an assembly DOTNET_STARTUP_HOOKS
       names nor one applied over the diagnostics channel is loaded before Main. A Debug
       build keeps .NET's default. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <!-- HttpClient's DiagnosticsHandler is left out of every handler chain, so a request
       reaches System.Diagnostics.Activity only where a tool outside the app listens to
       HttpClient's telemetry, metrics or activities. Activity's static constructor calls
       Guid.NewGuid, and .NET binds that call's ole32 import with a search that starts in
       the folder its own assemblies load from, which in a self-contained build is the
       exe's own folder.
       With no Activity listener in the process the handler adds nothing to a request. -->
  <PropertyGroup>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <!-- HttpClient never opens an HTTP/3 connection. One would load msquic.dll by its full
       path, which in a self-contained build is a path in the exe's own folder, and no
       resolver of the app's is asked about that load. With the switch in the runtimeconfig
       the connection pool never reaches System.Net.Quic, whatever version a request asks
       for, and the environment variable that turns HTTP/3 on is not read. -->
  <PropertyGroup>
    <Http3Support>false</Http3Support>
  </PropertyGroup>

  <!-- WPF-only dependencies. Headless services, models, helpers,
       interop and the localisation resx live in InstallerClean.Core
       and flow in via the project reference below. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Microsoft's stock dependency-injection container. The GUI uses
         it to wire every service the main view-model graph needs.
         InstallerClean.Core only needs the Abstractions package
         (callers register Core's services into their own collection). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstallerClean.Core\InstallerClean.Core.csproj" />
  </ItemGroup>

  <!-- Whether this build carries its own .NET runtime, written into the assembly so
       the update from inside the app can tell the portable download, which does,
       from the slim, which does not, and download the same kind again. The release
       workflow sets SelfContained on both publishes. RunningCopy reads it. -->
  <ItemGroup>
    <AssemblyMetadata Include="InstallerClean.SelfContained" Value="$(SelfContained)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Poppins-Regular.ttf" />
    <Resource Include="Fonts\Poppins-Medium.ttf" />
    <Resource Include="Fonts\Poppins-SemiBold.ttf" />
    <Resource Include="Fonts\Poppins-Bold.ttf" />
    <Resource Include="Fonts\Montserrat-Regular.ttf" />
    <Resource Include="Fonts\Montserrat-Medium.ttf" />
    <Resource Include="Fonts\Montserrat-SemiBold.ttf" />
    <Resource Include="Fonts\Montserrat-Bold.ttf" />
    <Resource Include="Assets\splash-icon.png" />
  </ItemGroup>

</Project>
