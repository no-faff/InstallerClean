<UserControl x:Class="InstallerClean.Controls.ScoopCommandBox"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InstallerClean.Resources"
             xmlns:chrome="clr-namespace:InstallerClean.Controls">
    <!-- Scoop's update command in a box it can be selected and copied from, the Copy button
         beside it, and the line saying the copy failed where the clipboard refused it. The
         notice at the top of the window and the update card each hold one, with the
         ChromeViewModel as the DataContext. OnCard centres the row and the failure line and
         takes the card's spacing; the notice's are the defaults. Copy's text is the
         view model's, and the two texts it can read are laid over it hidden, so the button
         is as wide as the wider of them and does not change width when it reads Copied. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CommandRow" TargetType="WrapPanel">
            <Setter Property="Margin" Value="{StaticResource GapTop.Sm}"/>
            <Setter Property="Visibility"
                    Value="{Binding ShowsScoopCommand, Converter={StaticResource BoolToVis}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnCard, RelativeSource={RelativeSource AncestorType={x:Type chrome:ScoopCommandBox}}}"
                             Value="True">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CommandFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface.Sidebar}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Action.Standard.Background}"/>
            <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnCard, RelativeSource={RelativeSource AncestorType={x:Type chrome:ScoopCommandBox}}}"
                             Value="True">
                    <Setter Property="Margin" Value="0,0,12,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopyFrame" TargetType="Border">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnCard, RelativeSource={RelativeSource AncestorType={x:Type chrome:ScoopCommandBox}}}"
                             Value="True">
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopyFailureLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
            <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{StaticResource GapTop.Sm}"/>
            <Setter Property="Visibility"
                    Value="{Binding HasScoopUpdateCopyFailed, Converter={StaticResource BoolToVis}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnCard, RelativeSource={RelativeSource AncestorType={x:Type chrome:ScoopCommandBox}}}"
                             Value="True">
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel Style="{StaticResource CommandRow}">
            <Border Style="{StaticResource CommandFrame}">
                <TextBox x:Name="CommandBox"
                         Style="{StaticResource SelectableText}"
                         Text="{Binding ScoopUpdateCommand, Mode=OneWay}"
                         Foreground="{StaticResource Text.Heading}"
                         FontFamily="Consolas, Cascadia Mono, Lucida Console"
                         FontSize="{DynamicResource Type.Body}"
                         AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.ScoopCommand}"/>
            </Border>
            <Border Style="{StaticResource CopyFrame}">
                <Button x:Name="CopyButton"
                        Style="{Binding CopyButtonStyle, RelativeSource={RelativeSource AncestorType={x:Type chrome:ScoopCommandBox}}}"
                        Command="{Binding CopyScoopUpdateCommand}"
                        AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.CopyCommand}">
                    <Grid>
                        <chrome:UnreadText Text="{loc:Translate Action.Copy}" Visibility="Hidden"/>
                        <chrome:UnreadText Text="{loc:Translate UpdateNotice.CommandCopied}" Visibility="Hidden"/>
                        <TextBlock Text="{Binding CopyScoopUpdateText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>
        </WrapPanel>
        <TextBlock x:Name="CopyFailure" Style="{StaticResource CopyFailureLine}"
                   Text="{loc:Translate UpdateNotice.CopyFailed}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
