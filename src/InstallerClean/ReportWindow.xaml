<Window x:Class="InstallerClean.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        WindowStyle="None" AllowsTransparency="True"
        FontFamily="{DynamicResource Type.FontFamily}"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: a centred-on-owner modal with no title-bar
             buttons, so no drag region is needed and the Border below claims
             the full window. -->
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- Card width scales with the OS text size so the report keeps its line
         length instead of scrolling sideways ever earlier as the text grows.
         Both widths are scaled and set in code-behind, held to the work area
         there. -->
    <Border x:Name="Card"
            Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.ModalCard}" Padding="{StaticResource Padding.ModalCard}"
            BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}">
        <!-- The report sits in a star row rather than a StackPanel: a vertical
             StackPanel measures its children at infinite height, so the box
             would never scroll and the Close button would clip once the
             window's work-area MaxHeight binds. Sized to content, the window
             shows as much of the report as the work area allows and the box
             scrolls for the rest, with the heading and Close always on screen. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="Heading" Grid.Row="0" Text="{loc:Translate Window.Report.Title}"
                       Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource GapBottom.Md}"/>

            <!-- The report as last-run.json holds it, read-only so it can be
                 selected and copied but not changed. A fixed-width font so the
                 JSON's indentation lines up, and no wrapping, so each line of the
                 file is one line here. The box scrolls itself in both directions,
                 so there is no outer ScrollViewer to take the mouse wheel, and
                 moving the caret scrolls it from the keyboard. Labelled by the
                 heading and named with its key, so a screen reader says what the
                 text is rather than a bare "edit, read-only". -->
            <Border x:Name="ReportBox" Grid.Row="1"
                    Background="{StaticResource Surface.Sidebar}" CornerRadius="{StaticResource Radius.Panel}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="12,10"
                    Margin="{StaticResource GapBottom.Lg}">
                <TextBox x:Name="ReportText"
                         Style="{StaticResource SelectableText}"
                         Foreground="{StaticResource Text.Body}"
                         FontFamily="Consolas, Cascadia Mono, Lucida Console"
                         FontSize="{DynamicResource Type.Body}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.LabeledBy="{Binding ElementName=Heading}"
                         AutomationProperties.Name="{loc:Translate Window.Report.Title}"/>
            </Border>

            <!-- In place of the box where the file could not be read. -->
            <TextBlock x:Name="UnreadableText" Grid.Row="1" Visibility="Collapsed"
                       Text="{loc:Translate Window.Report.Unreadable}"
                       Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource GapBottom.Lg}"/>

            <Button x:Name="CloseButton" Grid.Row="2" Style="{StaticResource StandardPill}"
                    Content="{loc:Translate Action.Close}" Click="OnClose"
                    IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
