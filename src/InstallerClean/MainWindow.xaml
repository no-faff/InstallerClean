<Window x:Class="InstallerClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:chrome="clr-namespace:InstallerClean.Controls"
        xmlns:a11y="clr-namespace:InstallerClean.Helpers"
        Title="{loc:Translate Window.Main.Title}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Type.FontFamily}"
        Background="{StaticResource Surface.Sidebar}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Scan.ScanCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <a11y:InstallerPathTextConverter x:Key="KeepInstallerPathWhole"/>
        <a11y:AnyPathTextConverter x:Key="BreakPathsAtFolders"/>
        <!-- A control's label that takes further lines where the control is
             given too little width for one, centred for a button and from the
             left for a check box. The control's Content stays the string, so its
             spoken name is still the label without its access-key marker, and
             the AccessText registers the access key, which reaches the control
             around it. -->
        <DataTemplate x:Key="WrappingCentredLabel">
            <AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="WrappingLabel">
            <AccessText Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
        <!-- The focus ring of the scrolling region on the scanning card and on the
             Move or Delete card, each of which reaches 4 up into the gap under the
             line above it. The ring is drawn 2 inside the region's top edge and 2
             outside its other three, so it sits in that gap rather than across the
             line. -->
        <!-- The panel the notice saying a newer version is available sits in, at the
             top of the main window: the card surface, edged in the accent. -->
        <Style x:Key="UpdateNoticePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Action.Accent.Background}"/>
            <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="WaitingRegionFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="{StaticResource Radius.Tight}"
                                BorderThickness="{StaticResource BorderThickness.Focus}"
                                BorderBrush="{DynamicResource Text.Body}"
                                Margin="-2,2,-2,-2"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Star, not Auto: under SizeToContent the star row measures
                 to its content like Auto would, but once this grid's
                 work-area MaxHeight (set in code-behind) binds at large
                 OS text scales the star row is what shrinks, engaging
                 the scan panel's internal ScrollViewer, so the bottom
                 nav below never clips. The cap sits on the grid rather
                 than the window so it constrains the measure pass and
                 the ScrollViewer learns its real budget; a window-level
                 MaxHeight only clamps the arrange. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar. Row 0 height matches WindowChrome.CaptionHeight (32)
             so the icon and the 32px caption buttons share a centerline.
             Left margin (16) matches where the detail windows' title bars
             land (Margin.DetailWindow 24 + StackPanel -8). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="16,0,0,0">
            <chrome:DecorativeImage Source="Assets/splash-icon.png" Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="{StaticResource GapRight.Sm}"/>
            <TextBlock Text="{loc:Translate Window.Main.Title}" Foreground="{StaticResource Text.Body}"
                       FontSize="{StaticResource Type.TitleBar}" FontWeight="Medium"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    Click="MinimizeClick" AutomationProperties.Name="{loc:Translate Automation.Minimise}"
                    ToolTip="{loc:Translate Tooltip.Minimise}"/>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                    Click="CloseClick" AutomationProperties.Name="{loc:Translate Automation.Close}"
                    ToolTip="{loc:Translate Tooltip.Close}"/>
        </StackPanel>

        <!-- Invisible scan-result announcer. Code-behind writes the
             composed "N unneeded files to clean up (size)" line here
             after a scan that found files, where the scan after a Move or
             Delete did not finish, why the window has no list, and "Copied"
             as Copy beside Scoop's update command answers a press, and
             reads each out as it writes it; the visible count rows carry no
             LiveSetting because they rebind on every refresh, including the
             silent post-operation one. Opacity 0, not Collapsed, keeps UI
             Automation reporting the element on screen, so no line is read
             out from an element marked offscreen. -->
        <TextBlock x:Name="ScanResultAnnouncer" Grid.Row="0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite"/>

        <!-- Row 1: the scan-result panel. The window is NoResize +
             SizeToContent="Height", so it grows to fit this content
             exactly and normally never needs a scrollbar; a tall warning
             banner makes the window taller rather than clipping the
             action buttons. The MaxWidth is the content width an 828
             window gives at 100% text scale and grows with the OS
             text-size factor in step with the explicit scaled window
             width set in code-behind, so the window widens with its
             text instead of starving the counts row.

             Stretch, never Center: a centred column sizes to its
             content, and in the states that collapse the wide elements
             (all-clean and not-yet-scanned, where the move box and the
             long lead are gone) it shrank to the counts grid and
             floated mid-window while the bottom nav stayed at the left
             margin. Stretch holds the column at the cell's width in
             every state, and if the cell ever outgrew MaxWidth a
             clamped stretched element is centred by WPF anyway, so the
             wide-window intent is unchanged. -->
        <!-- Hidden, not collapsed, while the card saying a newer version is available
             is up: the dim over it is half-transparent, so the scan would read through
             it, and the window keeps the size the scan gives it rather than changing
             size as the card goes. A hidden element is out of the tab order and out of
             what a screen reader can reach. -->
        <Grid Grid.Row="1" Margin="{StaticResource Margin.MainContent}"
              MaxWidth="{a11y:TextScaled 780}" HorizontalAlignment="Stretch"
              IsEnabled="{Binding IsMainContentInteractive}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Chrome.IsOfferingUpdate}" Value="True">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- The notice saying a newer version is available, the scan results,
                 the separator and the action zone, with no fixed spacer rows between
                 them: the separator and the action zone collapse together when
                 there is nothing to move or delete, and a fixed spacer row
                 holds its height whatever sits in it, so the collapsed pair
                 would leave 28 pixels of dead space above the bottom nav. The
                 separator carries that spacing in its own margin instead, which
                 goes with it, and the notice carries the gap under it the same way. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- A newer version than this one is available. Shown once a check has
                 found one, in every state of the window, above everything else and
                 outside the region that scrolls, so it stays in view at any text
                 size. Its Update now, Scoop's update command or its link is the first
                 Tab stop in the window's content. The code-behind reads its lines out,
                 ahead of the rest of the window as it is drawn. The link's spoken name
                 is its own words cased for speech. -->
            <Border Grid.Row="0" Style="{StaticResource UpdateNoticePanel}"
                    Margin="{StaticResource GapBottom.Lg}"
                    Visibility="{Binding Chrome.HasNewerVersion, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Update}"
                          Stroke="{StaticResource Link.Rest}" StrokeThickness="2" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="{a11y:TextScaled 20}" Height="{a11y:TextScaled 20}" Stretch="Uniform"
                          VerticalAlignment="Top" Margin="{StaticResource GapRight.Sm}"/>
                    <StackPanel>
                        <TextBlock x:Name="UpdateNoticeLead" Text="{Binding Chrome.UpdateNoticeText}"
                                   Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="UpdateNoticeDetail" Text="{Binding Chrome.UpdateNoticeDetailText}"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapTop.Sm}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <!-- After an update that failed: what failed, in the warning colour,
                             read out as it appears. -->
                        <TextBlock x:Name="UpdateNoticeFailure" Text="{Binding Chrome.UpdateFailureText}"
                                   Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapTop.Sm}"
                                   Visibility="{Binding Chrome.HasUpdateFailure, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <!-- On a copy installed by Scoop, in place of Update now: the line
                             saying how to update it, Scoop's command in a box it can be
                             selected and copied from, Copy, and the line saying the copy
                             failed where the clipboard refused it. The line's spoken name
                             carries the command, so reading the line out reads the command
                             too. The box's spoken name says what it holds, and a screen
                             reader reads the command after it. -->
                        <TextBlock x:Name="UpdateNoticeScoop" Text="{Binding Chrome.ScoopUpdateLine, Mode=OneWay}"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapTop.Sm}"
                                   Visibility="{Binding Chrome.ShowsScoopCommand, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.Name="{Binding Chrome.ScoopUpdateSpoken}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <chrome:ScoopCommandBox x:Name="UpdateNoticeScoopBox" DataContext="{Binding Chrome}"
                                                AutomationIdPrefix="UpdateNotice"
                                                CopyButtonStyle="{StaticResource CompactAccentPill}"/>
                        <!-- Update now wherever the app can update itself; the link where it
                             cannot or the newer version's release rules this copy out, and
                             beside Update now after an update that failed; the link to
                             Microsoft's .NET Framework 4.8 installer alone where the release
                             says this copy's download needs it and the PC does not have it. -->
                        <WrapPanel Margin="{StaticResource GapTop.Sm}">
                            <Button x:Name="UpdateNowButton" Style="{StaticResource CompactAccentPill}"
                                    Content="{loc:Translate UpdateNotice.UpdateNow}"
                                    Command="{Binding Chrome.UpdateNowCommand}"
                                    Margin="0,4,16,0" VerticalAlignment="Center"
                                    Visibility="{Binding Chrome.ShowsUpdateNow, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock FontSize="{DynamicResource Type.Body}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Chrome.ShowsReleaseLink, Converter={StaticResource BoolToVis}}">
                                <Hyperlink x:Name="UpdateNoticeDownloadLink"
                                           Command="{Binding Chrome.OpenReleasePageCommand}"
                                           Style="{StaticResource SubtleLink}"
                                           AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.Download}"><Run Text="{loc:Translate UpdateNotice.Download}"/></Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="{DynamicResource Type.Body}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Chrome.ShowsNetFrameworkLink, Converter={StaticResource BoolToVis}}">
                                <Hyperlink x:Name="UpdateNoticeNetFrameworkLink"
                                           Command="{Binding Chrome.OpenNetFrameworkDownloadCommand}"
                                           Style="{StaticResource SubtleLink}"
                                           AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.DownloadNetFramework48}"><Run Text="{loc:Translate UpdateNotice.DownloadNetFramework48}"/></Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Context: scan results. The explanation and counts sit in
                 a star row inside a ScrollViewer (NOT a StackPanel row: a
                 vertical StackPanel measures children at infinite height,
                 so an inner ScrollViewer never engages). When the window's
                 work-area MaxHeight binds at large text scales, this is
                 the block that scrolls; the separator, the action zone and
                 the bottom nav keep their full height below it. -->
            <!-- Negative right margin extends this region's viewport 4px past
                 the content's right edge; the inner StackPanel's matching
                 positive right margin holds the content back at that edge, and
                 its bottom margin grows the content the same 4px below its last
                 element. A ScrollContentPresenter owns an adorner layer clipped
                 to its viewport, so a focus visual (drawn 2px outside its
                 control by the *FocusVisual styles' Margin=-2) on a control
                 flush against the viewport edge is clipped on that side. The
                 left-alone row's "Details" pill sits flush right and, with no
                 missing-from-disk banner below it, flush bottom, so
                 its ring was cut on both; the 4px of viewport headroom clears it
                 while the pill stays aligned with the orphaned row's "Details"
                 and the action buttons at the content edge. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource BodyScrollRegion}"
                          Margin="0,0,-4,0"
                          AutomationProperties.Name="{loc:Translate Automation.Scroll.ScanResults}">
            <StackPanel Margin="0,0,4,4">

                <!-- Explanatory text in three tiers: the lead reassurance reads
                     prominent (heading tier), the "why" detail recedes (muted),
                     the action line sits at body tier. Three resx keys so each
                     styles independently; the lead and the detail bind to the
                     view-model, which picks them by scan state.

                     The block carries the gap below the intro, not its last
                     child: which child IS last changes with the state, so a
                     bottom margin on any one of them would vanish in the states
                     where it collapses. Its 8 plus the 8 on the last visible
                     line is the 16 the intro has always had under it. -->
                <StackPanel Margin="{StaticResource GapBottom.Sm}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Heading}"
                               FontSize="{DynamicResource Type.Heading.Sm}" Margin="{StaticResource GapBottom.Sm}"
                               Text="{Binding IntroLead, Converter={StaticResource KeepInstallerPathWhole}}"/>
                    <!-- The converter prepares the line for layout. It binds the
                         installer cache folder's path together so it cannot wrap
                         mid-path, the line naming the folder in three of its four
                         states, and gives the crash log's path break points at its
                         folders so a long one wraps rather than running off the
                         pane. The collapse trigger below reads the view-model
                         value, not the converted one, so its empty test is
                         unaffected. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Text="{Binding IntroDetail, Converter={StaticResource KeepInstallerPathWhole}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- Collapses on an all-clear, where the lead
                                         says it all; an empty TextBlock would
                                         still carry its line height and margin. -->
                                    <DataTrigger Binding="{Binding IntroDetail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- "Scan cancelled.", shown only in the not-yet-scanned
                         state. No LiveSetting: the code-behind reads it out
                         through ScanResultAnnouncer as the window opens. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Text="{Binding IntroNotice}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntroNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Action line hidden when a pending reboot holds Move and
                         Delete (bound to ShowMainAction, not Scan.HasOrphans): the
                         buttons are dead then, so an instruction to press them
                         reads as a broken app. The banner and the reworded lead
                         explain the hold instead. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Visibility="{Binding ShowMainAction, Converter={StaticResource BoolToVis}}"
                               Text="{loc:Translate Body.MainExplanation.Action}"/>
                </StackPanel>

                <!-- Pending reboot warning (Phosphor fill, tweaked !). DockPanel
                     (not a horizontal StackPanel) so the message wraps: a
                     horizontal StackPanel gives its child infinite width,
                     defeating TextWrapping and clipping the longer advisory
                     sentences off the right edge. Icon docks left and aligns to
                     the first line; the TextBlock fills the rest and wraps.

                     The text takes Type.Body, the token that goes with the
                     Text.Body role it already carries, and it has to be a size
                     token rather than nothing: the icon beside it is TextScaled,
                     so an unsized TextBlock leaves the warning growing with the
                     OS text-size setting while the sentence it belongs to stays
                     put. The missing-from-disk footnote further down pairs
                     Text.Muted with Type.Caption for the same reason. -->
                <DockPanel Margin="{StaticResource GapBottom.Lg}"
                           Visibility="{Binding Scan.HasPendingReboot, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <!-- LiveSetting=Polite, read out by code-behind when the
                         warning appears: after a scan, ahead of the headline
                         as it is drawn; after the card a scan put up, or as the
                         Move or Delete card goes where no card follows it; at a
                         Move or Delete click, at once. -->
                    <TextBlock x:Name="PendingRebootBannerText"
                               Text="{Binding Scan.PendingRebootBannerText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>

                <!-- Rule under the intro (and the pending-reboot warning when
                     shown): marks the explanation as its own section above the
                     scan counts. Matches the separator below the left-alone
                     count. Collapses with the counts it introduces: before the
                     first scan there are no counts, and a rule with nothing
                     under it is a stray line. -->
                <chrome:DecorativeBorder BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="0,1,0,0" Margin="{StaticResource GapBottom.Lg}"
                                         Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}"/>

                <!-- Unneeded (orphaned) count: the loud heading-tier row leads
                     the scan results, sitting above the quiet left-alone row
                     so position agrees with the existing emphasis. Both count
                     rows hang off HasScanned: "0 unneeded files" and "0 files
                     left alone" are a scan result, and printing them before
                     any scan has run tells a user who cancelled the startup scan
                     that their machine is clean. -->
                <Grid Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Wraps for the same width-clamp reason as the
                         left-alone line below. -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                               TextWrapping="Wrap"
                               Text="{Binding Scan.OrphanedSummaryText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Scan.OrphanedSizeDisplay}"
                               Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                               VerticalAlignment="Center" MinWidth="{a11y:TextScaled 72}" TextAlignment="Right"
                               Margin="{StaticResource GapX.Md}"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.Details}" Command="{Binding Chrome.OpenOrphanedDetailsCommand}"
                            MinHeight="28" Padding="12,0" FontSize="{DynamicResource Type.Heading.Sm}"
                            VerticalAlignment="Center" Margin="{StaticResource GapLeft.Md}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            AutomationProperties.Name="{loc:Translate Automation.ViewOrphanedFiles}"
                            AutomationProperties.HelpText="{loc:Translate Automation.ViewOrphanedFiles.HelpText}"/>
                </Grid>

                <!-- The quiet left-alone row sits a small gap (GapTop.Sm)
                     below the loud unneeded row above. -->
                <Grid Margin="{StaticResource GapTop.Sm}"
                      Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left alone. Wraps so a work-area width clamp at
                         large text scales shortens the line instead of
                         clipping it against the size column. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Heading.Sm}"
                               TextWrapping="Wrap"
                               Text="{Binding Scan.RegisteredSummaryText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Scan.RegisteredSizeDisplay}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Heading.Sm}"
                               VerticalAlignment="Center" MinWidth="{a11y:TextScaled 72}" TextAlignment="Right"
                               Margin="{StaticResource GapX.Md}"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.Details}" Command="{Binding Chrome.OpenRegisteredDetailsCommand}"
                            MinHeight="28" Padding="12,0" FontSize="{DynamicResource Type.Heading.Sm}"
                            VerticalAlignment="Center" Margin="{StaticResource GapLeft.Md}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            AutomationProperties.Name="{loc:Translate Automation.ViewRegisteredFiles}"
                            AutomationProperties.HelpText="{loc:Translate Automation.ViewRegisteredFiles.HelpText}"/>
                </Grid>

                <!-- Why the scan held back every file in the folder no record names, where
                     one of Windows Installer's in-progress signals was set when it read them
                     just after its clock, or the system clock went back while it read the
                     files' times. A footnote under the left-alone count, which counts
                     those files, in the form of the line below. Move and Delete do not follow
                     it: they follow the read after the scan, which the warning banner speaks
                     for. The text goes through the converter so the folder's path cannot wrap
                     part-way, and the screen-reader name is the line as composed. The
                     code-behind raises it after the scan's headline. -->
                <DockPanel Margin="{StaticResource GapTop.Sm}"
                           Visibility="{Binding Scan.HasScanSignal, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <TextBlock x:Name="ScanSignalText"
                               Text="{Binding Scan.ScanSignalText, Converter={StaticResource KeepInstallerPathWhole}}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Caption}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding Scan.ScanSignalText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>

                <!-- The drives and shares this scan carried on without while files
                     still had to be checked against them. Sits as a footnote under the
                     left-alone count, which counts those files, in the form of the
                     missing-files footnote below.

                     The text goes through the converter so a long share breaks at its
                     folders, and the screen-reader name is the line as composed, so the
                     characters that make those breaks reach the layout and not the
                     speech. The code-behind raises it after the scan's headline. -->
                <DockPanel Margin="{StaticResource GapTop.Sm}"
                           Visibility="{Binding Scan.HasSourcesGivenUp, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <TextBlock x:Name="SourcesGivenUpText"
                               Text="{Binding Scan.SourcesGivenUpText, Converter={StaticResource BreakPathsAtFolders}}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Caption}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding Scan.SourcesGivenUpText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>

                <!-- Registered files missing from disk. Sits as a footnote
                     under the left-alone count: a missing file is one of the
                     needed files, Windows still expects it, it just isn't on
                     disk. DockPanel (not a horizontal StackPanel) so the
                     advisory wraps; icon docks left, aligned to the first line.

                     The text takes Type.Caption, and it has to be a size token
                     rather than nothing: the icon beside it is TextScaled, so an
                     unsized TextBlock leaves the warning growing with the OS
                     text-size setting while the sentence it belongs to stays put.

                     The code-behind reads it out when it appears or its count
                     changes: after the scan's headline and the line above, after
                     the card a scan put up, or as the Move or Delete card goes where
                     no card follows it. -->
                <DockPanel Margin="{StaticResource GapTop.Sm}"
                           Visibility="{Binding Scan.HasMissingFromDisk, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <TextBlock x:Name="MissingFromDiskBannerText"
                               Text="{Binding Scan.MissingFromDiskSummaryText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Caption}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>




            </StackPanel>
            </ScrollViewer>

            <!-- Separator. It carries the 16 above and 12 below in its own
                 margin so the spacing collapses with it; fixed spacer rows
                 hold their height whatever sits in them. -->
            <chrome:DecorativeBorder Grid.Row="2" BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="0,1,0,0"
                                     Margin="0,16,0,12"
                                     Visibility="{Binding ShowActionZone, Converter={StaticResource BoolToVis}}"/>

            <!-- Action zone: move/delete -->
            <Grid Grid.Row="3"
                  Visibility="{Binding ShowActionZone, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Backup folder label -->
                <TextBlock Grid.Row="0" Text="{loc:Translate Section.Backup.Folder}"
                           Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Heading.Sm}"
                           AutomationProperties.Name="{loc:Translate Automation.Section.BackupFolder}"/>

                <!-- Move destination -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The placeholder is the box's Tag, rendered inside the
                         PillTextBox template so it lines up with the caret;
                         there is no separate tooltip: the placeholder
                         carries the what and the why.

                         Tag text is drawn by the template and reaches no
                         screen reader, so the same key is also the box's
                         HelpText. It is deliberately one key feeding both:
                         the hint a screen reader hears and the hint on
                         screen are the same sentence by construction and
                         cannot drift apart, which is the failure two
                         separate strings produce. -->
                    <TextBox Grid.Column="0" x:Name="MoveDestinationInput" Style="{StaticResource PillTextBox}"
                             Text="{Binding Cleanup.MoveDestination, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="8192"
                             Tag="{loc:Translate Action.BackupFolderPlaceholder}"
                             AutomationProperties.Name="{loc:Translate Automation.BackupFolder}"
                             AutomationProperties.HelpText="{loc:Translate Action.BackupFolderPlaceholder}"/>

                    <Button Grid.Column="2" Style="{StaticResource GhostPill}" Padding="12,8"
                            Content="{loc:Translate Action.Browse}" Command="{Binding Cleanup.BrowseDestinationCommand}"/>
                </Grid>

                <!-- Buttons row. Move is the emphasised action, on the accent
                     pill in the rightmost slot; Delete permanently is the quiet
                     one to its left, on the standard pill.

                     The emphasis is not a warning and there is no red anywhere
                     on this screen. The window's first line says these files are
                     safe to delete, and red would be the one element arguing
                     with it. What emphasising Move does carry is a nudge
                     towards prudence, and that was weighed and accepted rather
                     than arrived at: move if you can, for peace of mind, delete
                     if you would rather take the app at its word or are in a
                     hurry. Both are ordinary outcomes and the screen treats
                     them as such.

                     Dock="Right" gives the first declared child the
                     furthest-right slot, so Move is declared first and Delete
                     takes the one to its left, carrying the gap between the
                     two.

                     TabIndex pins MOVE first, and the principle behind it is
                     older than this arrangement: the primary action is the one
                     a keyboard reaches first. Delete held that place while
                     Delete was the emphasised button, so moving it to Move
                     keeps the principle rather than dropping it. The cost was
                     weighed and taken: tab order no longer agrees with
                     left-to-right visual order, so a sighted keyboard user sees
                     focus land on the right-hand button first. Against that, a
                     screen-reader user meets the recommended action first,
                     which is the emphasis this screen now carries on purpose. -->
                <!-- Each button's help text is its own tooltip, not a second
                     sentence written alongside it. Two sources for one
                     explanation drift apart, leaving the screen saying one
                     thing and a screen reader another; one value feeding both
                     cannot, which is the same reasoning the move-destination
                     box's placeholder carries above. Move's is the view-model
                     property because its tooltip has three states, and the
                     state a screen reader needs most is the one that warns a
                     folder browser opens first. -->
                <DockPanel Grid.Row="4" KeyboardNavigation.TabNavigation="Local">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}"
                            KeyboardNavigation.TabIndex="0"
                            Content="{loc:Translate Action.Move}" Command="{Binding Cleanup.MoveAllCommand}"
                            AutomationProperties.HelpText="{Binding Cleanup.MoveButtonTooltip}"
                            ToolTip="{Binding Cleanup.MoveButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True"/>

                    <Button DockPanel.Dock="Right" Style="{StaticResource StandardPill}"
                            KeyboardNavigation.TabIndex="1"
                            Content="{loc:Translate Action.DeletePermanently}" Command="{Binding Cleanup.DeleteAllCommand}"
                            AutomationProperties.HelpText="{loc:Translate Tooltip.Delete}"
                            ToolTip="{loc:Translate Tooltip.Delete}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="{StaticResource GapRight.Sm}"/>

                    <!-- No LiveSetting: this body-row line sits behind the
                         operating overlay for as long as its text changes,
                         and the overlay's own heading is the line read out
                         then. -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Cleanup.OperationProgress}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Body}"
                               TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 280}"/>
                </DockPanel>
            </Grid>

        </Grid>

        <!-- Bottom nav. Asymmetric Margin: 4 left because Re-scan
             and About are GhostPills with their own internal padding;
             24 right for clearance between the right-anchored chrome
             icons and the window-close hit area above. One-off;
             a literal Thickness rather than a Gap token. -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="4,8,24,8"
                   KeyboardNavigation.TabNavigation="Local"
                   IsEnabled="{Binding IsMainContentInteractive}">
            <Button x:Name="RescanButton" DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="0"
                    Content="{loc:Translate Action.Rescan}" Command="{Binding Scan.ScanCommand}"
                    AutomationProperties.HelpText="{loc:Translate Automation.RescanInstaller}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="1"
                    Content="{loc:Translate Action.About}" Command="{Binding Chrome.ShowAboutCommand}" Margin="4,0,0,0"/>
            <!-- Manual update check. The automatic once-per-session check
                 fires at launch without a click; this button is for anyone
                 who wants to ask again, and it is the only control that
                 reports an up-to-date result or a failure, because the
                 automatic path is deliberately silent on both. A newer version
                 either check finds shows as the notice at the top of the
                 window. Its own execution covers the cooldown, so the pill's
                 disabled paint is the feedback while it runs. -->
            <Button x:Name="UpdateCheckButton" DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="2"
                    Content="{loc:Translate Action.CheckForUpdates}"
                    Command="{Binding Chrome.CheckForUpdatesCommand}" Margin="4,0,0,0"
                    Click="UpdateCheckButton_Click"
                    IsEnabledChanged="UpdateCheckButton_IsEnabledChanged"
                    AutomationProperties.Name="{loc:Translate Automation.CheckForUpdates}"
                    AutomationProperties.HelpText="{loc:Translate Automation.CheckForUpdates.HelpText}"/>
            <!-- Language switcher: a wordless globe so it reads in any UI
                 language. It opens a menu of language names (endonyms) with
                 the running one ticked (LanguageButton_Click); picking
                 another restarts the app into it. Declared before the status
                 line below (which docks Left) so the DockPanel reserves its
                 slot at the far right first and the status line takes only
                 what is left between the buttons and the globe, which is
                 also what gives the status line a width to ellipsize
                 against. TabIndex 3 puts it last in the bar's reading order,
                 after the update button, rather than at its declaration
                 position. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostPill}"
                    x:Name="LanguageButton"
                    KeyboardNavigation.TabIndex="3"
                    Click="LanguageButton_Click"
                    AutomationProperties.Name="{loc:Translate Automation.ChangeLanguage}"
                    AutomationProperties.HelpText="{loc:Translate Automation.ChangeLanguage.HelpText}"
                    ToolTipService.InitialShowDelay="0"
                    ToolTip="{loc:Translate Tooltip.ChangeLanguage}">
                <!-- The globe is the whole button, so it is what carries the OS
                     text size here: SmallGhostPill's 28 is a minimum height and
                     a wordless button has no label to push past it, so without
                     the scaling it would be the smallest target in the app at
                     exactly the scale where everything else has doubled. The
                     stroke stays 2: Shape applies Stretch to the geometry and
                     the pen after it, so the outline holds its weight as the
                     circle grows, which is what a line drawing wants. -->
                <Path Data="M2 12 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0 M12 2 a4.2 10 0 1 0 0 20 a4.2 10 0 1 0 0 -20 M2 12 h20"
                      Stroke="{StaticResource Text.Muted}" StrokeThickness="2" Fill="{x:Null}"
                      Width="{a11y:TextScaled 18}" Height="{a11y:TextScaled 18}" Stretch="Uniform"/>
            </Button>
            <!-- Update status line: "Checking..." while the manual check runs and
                 "Up to date." when it answers so, empty and collapsed otherwise. It
                 docks Left after the globe so it takes the space between the
                 buttons and the globe, which is also what gives it a width to
                 ellipsize against. A live region, read out by code-behind each
                 time its text changes while it shows (OnChromePropertyChanged).

                 Assertive, and the transience is what decides it. A manual check
                 answers within a second or two of the click, while the screen
                 reader is typically still reading the button's own name and help
                 text, and a polite item raised behind that loses its turn and is
                 gone (the line clears itself after the cooldown), so "Up to
                 date." goes unspoken. What makes interrupting acceptable is that
                 only the manual check ever paints this line, so an assertive
                 cut-in is always the answer to a click, never something
                 unprompted talking over the user. It can still land in the
                 middle of something else they started, because the check
                 disables only its own button and Re-scan stays live for the
                 whole cooldown: press both and "Up to date." cuts into the
                 scanning overlay's polite announcements. Accepted, on the same
                 grounds. The window for it is a few seconds wide and the user
                 opened it themselves. -->
            <TextBlock x:Name="UpdateStatusLineText"
                       DockPanel.Dock="Left" Text="{Binding Chrome.UpdateStatusText}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource Text.Muted}"
                       FontSize="{DynamicResource Type.Body}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Assertive">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Chrome.UpdateStatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Scanning overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Scan.IsScanning, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <!-- Opaque card over the dim, as on the operating overlay below and
                 on the confirm dialogs. Without it the bar and the milestone
                 line sit straight on the half-transparent dim and the summary
                 rows behind them read through.

                 The width comes from the window rather than the content. The
                 milestone line is replaced at each step of a scan and the steps
                 are different lengths, so a card that took its width from the
                 text would resize several times in one scan. Stretched, the card
                 fills the window less the 24 each side the content column keeps,
                 up to 480 scaled, and the line wraps inside that: at its full
                 width it holds the longest English step on one line, and the
                 longer German ones take two. Scaled, so the card keeps pace with
                 the text it holds. A window too narrow for the full width, as a
                 large text size on a narrow screen gives, narrows the card with
                 it, and a stretched card held below its slot by MaxWidth is
                 centred by WPF. -->
            <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="28,22" MaxWidth="{a11y:TextScaled 480}" Margin="{StaticResource GapX.Xl}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <ProgressBar IsIndeterminate="True" MaxWidth="240" Height="8" Margin="{StaticResource GapBottom.Md}"
                                     AutomationProperties.Name="{loc:Translate Automation.ScanningProgress}"/>
                        <!-- The text drawn takes break opportunities inside a path
                             the line names, as a wait on a share does; the name a
                             screen reader speaks is the line as composed, followed,
                             while the stop-waiting button shows, by its key and what
                             it leaves alone. The code-behind reads it out as the card
                             appears and each time it changes while the scan runs.

                             The 4 under it and the 4 over the ticker keep the 8
                             between the two that the scale gives, while the waiting
                             region below, which takes no space when collapsed, puts its
                             button 4 under this line when it shows. -->
                        <TextBlock x:Name="ScanProgressText"
                                   Text="{Binding Scan.ScanProgress, Converter={StaticResource BreakPathsAtFolders}}"
                                   Foreground="{StaticResource Text.Heading}"
                                   FontSize="{DynamicResource Type.Heading.Sm}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,4"
                                   AutomationProperties.Name="{Binding Scan.ScanProgressName}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <!-- What a wait adds to the card, shown only while the line above names a
                         wait, and the only part of the card that scrolls. Where the card is
                         taller than the window, as a wait naming a long share at a large text
                         size makes it, this region scrolls while the bar, the milestone line
                         and Cancel stay in view. The milestone line sits outside it because it
                         is read out, and a line scrolled out of view is reported off screen.
                         The button keeps FocusRing.Room from the region's top and sides, so
                         its focus ring is drawn whole, and the region reaches the same
                         distance up into the gap under the line, so the button sits 4 under
                         the line. -->
                    <ScrollViewer x:Name="ScanWaitingRegion" Grid.Row="1" Style="{StaticResource BodyScrollRegion}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,-4,0,0"
                                  Visibility="{Binding Scan.CanStopWaiting, Converter={StaticResource BoolToVis}}"
                                  FocusVisualStyle="{StaticResource WaitingRegionFocusVisual}"
                                  AutomationProperties.Name="{loc:Translate Automation.Scroll.Waiting}">
                        <StackPanel>
                            <!-- It gives up on the drive or share the line above names and
                                 the scan carries on; Cancel below still ends the scan. It
                                 never takes the focus itself, and code-behind hands the focus
                                 to Cancel as the region goes, if it or the region has it.

                                 The label is an AccessText that wraps, so in a card too
                                 narrow for it on one line it takes two and the button is
                                 never wider than the card. The access key works as it does
                                 on a plain string: the AccessText registers it, and the
                                 key press reaches the button around it. -->
                            <Button x:Name="ScanStopWaitingButton" Style="{StaticResource GhostPill}"
                                    Margin="4,4,4,0"
                                    Command="{Binding Scan.StopWaitingCommand}"
                                    MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                                    HorizontalAlignment="Center"
                                    FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                                    AutomationProperties.Name="{Binding Scan.StopWaitingName}"
                                    AutomationProperties.HelpText="{loc:Translate Status.StopWaitingLeavesAlone}">
                                <AccessText Text="{loc:Translate Action.StopWaiting}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <!-- What the button leaves alone, shown with it, in the ticker's
                                 colour and size. No LiveSetting: the line's spoken name
                                 carries the same sentence while the button shows. -->
                            <TextBlock x:Name="ScanStopWaitingLeavesAlone"
                                       Text="{loc:Translate Status.StopWaitingLeavesAlone}"
                                       Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,2,0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <!-- Ticker: a count of the folder's files as the scan
                             lists them, the name of each installed program as it
                             asks Windows about it, then a count of the files as it
                             matches them. Display-only and never read out, because
                             it updates once per program and many times while the
                             files are counted, and reading each update would queue
                             speech far faster than it is spoken. The milestone line
                             above is the one read out. -->
                        <TextBlock Text="{Binding Scan.ScanTicker}"
                                   Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                                   HorizontalAlignment="Center" Margin="0,4,0,16"
                                   TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 240}"/>
                        <Button x:Name="ScanCancelButton" Style="{StaticResource GhostPill}"
                                Content="{loc:Translate Action.Cancel}" Command="{Binding Scan.CancelScanCommand}"
                                MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                                HorizontalAlignment="Center"
                                FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                                AutomationProperties.Name="{loc:Translate Automation.CancelScan}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Operating overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Cleanup.IsOperating, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <!-- The card takes its width from its content, up to the scanning
                 card's width, and keeps the scanning card's 24 from each side of
                 the window, so in a window too narrow for 480 scaled it is still
                 never wider than the scanning card. A longer heading, as a wait
                 naming a long share is, wraps inside that rather than widening
                 the card. The MinWidth keeps a short heading's card wide enough
                 for the 200 of the bar, and is held to the window less the 24
                 each side in code-behind (KeepMinWidthInsideRoom), so in a window
                 too narrow for it the card narrows with the window, and the bar,
                 which stops at 200, narrows with the card. -->
            <Border x:Name="OperatingCard" Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="28,22" MinWidth="260" MaxWidth="{a11y:TextScaled 480}" Margin="{StaticResource GapX.Xl}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Code-behind reads this heading out when the overlay
                         appears, and again each time it changes while the
                         overlay is up: a wait, the heading put back, "Cancelling..."
                         and the scan after the batch. The view-model assigns the
                         first heading before IsOperating reveals the overlay, so
                         the reveal is what reads it; assigned after the reveal,
                         it would be read for the change and again for the reveal.

                         The text drawn takes break opportunities inside a path the
                         heading names, as a wait on a share does; the name a
                         screen reader speaks is the heading as composed, followed,
                         while the stop-waiting button shows, by its key and what it
                         leaves alone.

                         The 4 under it and the 12 over the bar keep the 16 between
                         the two that the scale gives, while the waiting region below,
                         which takes no space when collapsed, puts its button 4 under the
                         heading when it shows. -->
                    <TextBlock x:Name="OperationHeadingText" Grid.Row="0"
                               Text="{Binding Cleanup.OperationProgress, Converter={StaticResource BreakPathsAtFolders}}"
                               Foreground="{StaticResource Text.Heading}"
                               FontSize="{DynamicResource Type.Heading.Sm}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,4"
                               AutomationProperties.Name="{Binding Cleanup.OperationProgressName}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <!-- What a wait adds to the card, shown only while the heading names a
                         wait, and the only part of the card that scrolls. Where the card is
                         taller than the window, as a wait naming a long share at a large text
                         size makes it, this region scrolls while the heading, the bar, the
                         count and Cancel stay in view. The heading and the count's spoken twin
                         sit outside it because they are read out, and a line scrolled out of
                         view is reported off screen. Its margins are the scanning card's. -->
                    <ScrollViewer x:Name="OperationWaitingRegion" Grid.Row="1" Style="{StaticResource BodyScrollRegion}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,-4,0,0"
                                  Visibility="{Binding Cleanup.CanStopWaiting, Converter={StaticResource BoolToVis}}"
                                  FocusVisualStyle="{StaticResource WaitingRegionFocusVisual}"
                                  AutomationProperties.Name="{loc:Translate Automation.Scroll.Waiting}">
                        <StackPanel>
                            <!-- It gives up on the drive or share the heading names and the
                                 check, or the scan after the files have gone, carries on;
                                 Cancel below still ends it. It never takes the focus itself,
                                 and code-behind hands the focus to Cancel as the region goes,
                                 if it or the region has it. Its label wraps as the scanning
                                 card's does. -->
                            <Button x:Name="OperationStopWaitingButton" Style="{StaticResource GhostPill}"
                                    Margin="4,4,4,0"
                                    Command="{Binding Cleanup.StopWaitingCommand}"
                                    MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                                    HorizontalAlignment="Center"
                                    FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                                    AutomationProperties.Name="{Binding Cleanup.StopWaitingName}"
                                    AutomationProperties.HelpText="{loc:Translate Status.StopWaitingLeavesAlone}">
                                <AccessText Text="{loc:Translate Action.StopWaiting}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <!-- What the button leaves alone, shown with it. No LiveSetting:
                                 the heading's spoken name carries the same sentence while the
                                 button shows. -->
                            <TextBlock x:Name="OperationStopWaitingLeavesAlone"
                                       Text="{loc:Translate Status.StopWaitingLeavesAlone}"
                                       Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <!-- Indeterminate from the re-verify before a batch until its
                             first file, and for the rescan after a batch, where there
                             is no per-file progress to report: before the batch a
                             filled bar would describe files not yet reached, and after
                             it the batch that has ended. The count
                             row and the filename below go with it, on the same
                             binding, so the card is a heading and a moving bar,
                             which is what the scanning overlay above already is. -->
                        <ProgressBar Value="{Binding Cleanup.OperationProgressPercent}"
                                     IsIndeterminate="{Binding Cleanup.IsOperationProgressIndeterminate}"
                                     Minimum="0" Maximum="100"
                                     MaxWidth="200" Height="8" Margin="0,12,0,8"
                                     AutomationProperties.Name="{loc:Translate Automation.OperationProgress}"/>
                        <!-- The 0,0,0,2 here and the 0,4,0,0 on the filename below sit
                             off the 8/12/16/24 spacing scale on purpose: they tighten
                             the "X of Y" / percentage row and the filename into one
                             compact block under the progress bar, where the scale's
                             8px would loosen the grouping. -->
                        <DockPanel Margin="0,0,0,2"
                                   Visibility="{Binding Cleanup.ShowOperationProgressDetail, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}">
                                <Run Text="{Binding Cleanup.OperationProgressPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}"/>
                            </TextBlock>
                            <Grid>
                                <!-- Visible count: updates once per file and is
                                     never read out, because reading each file
                                     would flood the speech queue on a large
                                     batch. -->
                                <TextBlock Text="{Binding Cleanup.OperationProgressDetail}"
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="{DynamicResource Type.Caption}"/>
                                <!-- Screen-reader twin: the same "X of Y files"
                                     line, updated at most once per tenth of the
                                     batch (first and last file always), and read
                                     out by code-behind each time, so the
                                     announcements keep pace with speech. Opacity
                                     0, not Collapsed, keeps UI Automation
                                     reporting it on screen, without painting over
                                     the visible count. -->
                                <TextBlock x:Name="OperationProgressAnnouncementText"
                                           Text="{Binding Cleanup.OperationProgressAnnouncement}"
                                           Foreground="{StaticResource Text.Muted}"
                                           FontSize="{DynamicResource Type.Caption}"
                                           Opacity="0" IsHitTestVisible="False"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </DockPanel>
                        <!-- Never read out: the per-file filename changes at
                             I/O speed and would flood the screen-reader queue
                             faster than the user can drain it. The throttled
                             twin above carries the "X of Y" count for the SR. -->
                        <TextBlock Text="{Binding Cleanup.OperationCurrentFileName}"
                                   Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 240}"
                                   Visibility="{Binding Cleanup.ShowOperationProgressDetail, Converter={StaticResource BoolToVis}}"/>
                        <!-- Cancel button binds IsEnabled via the
                             CanCancelOperation predicate, so it is out of use
                             where the operation has nothing running that it
                             could stop, and a second click after the
                             cancel-in-flight is dropped. The
                             tooltip set by the IsCancellationRequested
                             trigger explains the disabled state during the
                             several-second window between Cancel and the
                             next CancellationToken checkpoint, mirroring
                             the splash window's pattern. -->
                        <Button x:Name="OperationCancelButton" Content="{loc:Translate Action.Cancel}"
                                Command="{Binding Cleanup.CancelOperationCommand}"
                                AutomationProperties.Name="{loc:Translate Automation.CancelOperation}"
                                FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                                HorizontalAlignment="Center" Margin="{StaticResource GapTop.Sm}"
                                MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostPill}">
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                    <Style.Triggers>
                                        <!-- HelpText alongside the ToolTip, from
                                             the same key: a WPF ToolTip opens on
                                             hover and never on keyboard focus, so
                                             without it the one sentence explaining
                                             a button that has just gone dead
                                             reaches a mouse user only. -->
                                        <DataTrigger Binding="{Binding Cleanup.IsCancellationRequested}" Value="True">
                                            <Setter Property="ToolTip" Value="{loc:Translate Tooltip.CancellingPending}"/>
                                            <Setter Property="AutomationProperties.HelpText" Value="{loc:Translate Tooltip.CancellingPending}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Completion overlay. TabNavigation="Cycle" traps Tab
             inside the overlay. 1px BorderBrush matches the confirm
             dialogs. -->
        <Grid x:Name="CompletionOverlay" Grid.RowSpan="3" Visibility="{Binding Completion.IsComplete, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <!-- Clicking the dim margin dismisses the overlay (the
                 inner Border absorbs its own clicks). -->
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"
                       MouseLeftButtonDown="CompletionDimAreaClick"
                       Cursor="Arrow"/>
            <!-- The card's width runs from 340 to 520 scaled, set in
                 code-behind (KeepCardInsideRoom), so the copy keeps its line
                 length as the OS text size grows instead of wrapping into a
                 tall sliver. Both are held to the window less the 24 each
                 side the other two overlay cards keep, so in a window too
                 narrow for 340 scaled the card narrows with it. -->
            <Border x:Name="CompletionCard" Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="36,32" Margin="{StaticResource GapX.Xl}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Grid, not a StackPanel: the icon, heading and buttons
                     sit in Auto rows and the variable-length copy in a
                     star row, so when the card runs out of window height
                     at large text scales the copy scrolls and the buttons
                     stay visible. A vertical StackPanel would measure at
                     infinite height and clip the buttons instead. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon -->
                    <chrome:DecorativeImage Grid.Row="0" Source="Assets/splash-icon.png"
                           Width="64" Height="64" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="{StaticResource GapBottom.Lg}"/>

                    <!-- Heading. Wraps rather than clipping: it is a translated
                         sentence, in every language the app ships, inside a card
                         of bounded width, and unwrapped it runs off both ends.

                         Foreground is set through the Style, not as an
                         attribute, because an attribute is a local value and a
                         local value beats a trigger's setter: with the inline
                         Foreground still there the warning colour would never
                         paint, whatever HeadingIsWarning said. Green is the
                         default; the warning amber is for the one outcome where
                         nothing succeeded. -->
                    <TextBlock x:Name="CompletionHeadingText" Grid.Row="1" Text="{Binding Completion.Heading}"
                               FontSize="{DynamicResource Type.Heading.Lg}" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="{StaticResource GapBottom.Sm}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.HeadingIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource BodyScrollRegion}"
                                  AutomationProperties.Name="{loc:Translate Automation.Scroll.ResultDetails}">
                    <StackPanel>

                    <!-- Failure count. Its own line, directly under the heading
                         and above the summary, so the heading carries one
                         message and the summary's destination path is never
                         followed by an error count that reads as part of the
                         folder name. Empty (and collapsed) on every run that
                         failed at nothing, which is nearly all of them.
                         LiveSetting because after the outcome itself this is
                         the next thing a screen-reader user needs. -->
                    <TextBlock x:Name="CompletionFailedCountText"
                               Text="{Binding Completion.FailedCount}"
                               Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Heading.Sm}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Sm}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.FailedCount}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 6px bottom (off the 8/12/16/24 scale) tightens
                         the summary against the caption that follows
                         (the reassurance on an all-clear, the restore
                         hint after a Move or Delete); GapBottom.Sm (8)
                         loosens the pairing visibly. Inlines are composed
                         in code-behind (BuildCompletionSummaryLine) so a
                         Move's destination path always starts its own
                         line, at whatever point it substitutes into the
                         formatted sentence for the current language; a
                         plain Text binding cannot force a line break at a
                         dynamic position, so there is no Text binding
                         here. -->
                    <TextBlock x:Name="CompletionSummaryText"
                               Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Heading.Sm}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               AutomationProperties.LiveSetting="Polite">
                        <!-- Collapses when Summary is empty, which an operation
                             that acted on no file at all leaves it: the summary
                             would otherwise say files went somewhere none did.
                             Without the trigger an empty TextBlock still holds
                             its bottom margin and line height, so the daft line
                             becomes a phantom gap, the same reason the restore
                             and skipped blocks below carry one. The trigger
                             reads Completion.Summary even though the visible
                             inlines are composed in code-behind. -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Summary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Restore guidance, after a Move and on the all-clear
                         receipt. Collapses when empty, so the card does
                         not carry a phantom 30+ pixel gap from the bottom margin
                         plus line-height of an empty TextBlock. Pattern matches
                         the Errors Border below.
                         LiveSetting + the code-behind raise on reveal: this
                         line is the second half of the outcome (where the files
                         went after a Move; the scan receipt on an all-clear).
                         The converter binds the installer cache folder's path
                         together so it cannot wrap mid-path, the cancelled-Move
                         line naming the folder. -->
                    <TextBlock x:Name="CompletionRestoreText"
                               Text="{Binding Completion.Restore, Converter={StaticResource KeepInstallerPathWhole}}"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Xl}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Restore}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- How many files the check made just before acting held back,
                         and on a line of its own any drive or share it carried on
                         without; empty (and collapsed) where it held nothing back.
                         LiveSetting so it is announced with the outcome. The converter
                         lets a long share break at its folders, and the screen-reader
                         name is the text as composed, as on the main window's line
                         naming the drives and shares given up. -->
                    <TextBlock x:Name="CompletionSkippedText"
                               Text="{Binding Completion.Skipped, Converter={StaticResource BreakPathsAtFolders}}"
                               AutomationProperties.Name="{Binding Completion.Skipped}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Xl}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Skipped}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Why the scan held files back for something about the scan itself:
                         files changed after it began, or Windows Installer busy as it began,
                         or the clock going back while it ran. Empty (and collapsed) on every card whose scan held none back
                         for either. Through the converter, since the second names the
                         folder; the screen-reader name is the line as composed. LiveSetting
                         so it is announced with the outcome. -->
                    <TextBlock x:Name="CompletionScanStartText"
                               Text="{Binding Completion.ScanStartLine, Converter={StaticResource KeepInstallerPathWhole}}"
                               AutomationProperties.Name="{Binding Completion.ScanStartLine}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Xl}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.ScanStartLine}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Error details (only visible when there are errors).
                         160 rather than 80: at 80 the box showed about two
                         lines, so a single group heading and one filename
                         filled it and everything else was behind a scrollbar.
                         It still scrolls internally and the card's own scroll
                         region backs it up, so a hundred failures cannot push
                         the buttons off screen. -->
                    <Border Margin="{StaticResource GapBottom.Xl}" MaxHeight="{a11y:TextScaled 160}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Errors}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Named so the tab stop reads as a labelled field; an
                             unnamed read-only TextBox announces a bare "edit,
                             read-only" with no hint of what the text is. -->
                        <TextBox Text="{Binding Completion.Errors, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 AutomationProperties.Name="{loc:Translate Automation.CompletionErrors}"
                                 Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Caption}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- The card's buttons. Done with a small tip button under it on
                         every card but one, and on that one, the card after a
                         Move or Delete that moved or deleted files, the large tip
                         button over "Close without tipping". Exactly one of Done and
                         Close without tipping is ever on screen, and one of
                         the two tip buttons.

                         Done and Close without tipping close the result
                         overlay and not the app: exiting from here would trap the
                         user with no way to re-scan or open About. Whichever is
                         showing is focused on overlay show, so a keyboard user
                         lands on the dismiss action with a visible ring; Enter
                         follows from IsDefault and Esc from the window's own key
                         handler, so neither needs the focus. Neither tip
                         button is focused or the default, so Enter closes the
                         card on every card. In English Alt+D is Done on the cards
                         that carry it, Alt+L the large tip button and Alt+C Close
                         without tipping on the one that does not, and the small
                         tip button takes no access key. -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                        <Button x:Name="CompletionCloseButton"
                                Content="{loc:Translate Action.Done}" ContentTemplate="{StaticResource WrappingCentredLabel}"
                                Command="{Binding Completion.DismissCommand}"
                                IsDefault="True"
                                HorizontalAlignment="Center" MinWidth="120"
                                Margin="{StaticResource GapBottom.Sm}"
                                AutomationProperties.HelpText="{loc:Translate Automation.CloseResult}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Completion.AsksForDonation}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Under Done, on every card that carries it. It opens
                             the tip page and leaves the card up. Hover text is
                             invisible to a screen reader, which is why the same
                             sentence is also the HelpText. A TextBlock rather than
                             an AccessText: the label takes no access key, Done
                             being beside it, so an underscore reaching this string
                             is shown as written. -->
                        <Button Command="{Binding Completion.DonateSmallCommand}"
                                HorizontalAlignment="Center" Padding="12,0"
                                Margin="{StaticResource GapBottom.Sm}"
                                ToolTipService.InitialShowDelay="0"
                                AutomationProperties.Name="{loc:Translate Automation.DonateSmall}"
                                AutomationProperties.HelpText="{loc:Translate Completion.DonateAsk}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallGhostPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Completion.AsksForDonation}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Heart}"
                                      Fill="{StaticResource Decoration.Heart}" Stretch="Uniform"
                                      Width="{a11y:TextScaled 12}" Height="{a11y:TextScaled 12}"
                                      VerticalAlignment="Center" Margin="{StaticResource GapRight.Icon}"/>
                                <TextBlock Text="{loc:Translate Action.DonateSmall}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </DockPanel>
                            <Button.ToolTip>
                                <ToolTip x:Name="CompletionDonateToolTip"
                                         Style="{StaticResource AccentTooltip}"
                                         Content="{loc:Translate Completion.DonateAsk}"
                                         Placement="Custom"/>
                            </Button.ToolTip>
                        </Button>

                        <!-- Larger than Done. Hover text is invisible to a screen
                             reader, which is why the same sentence is also the
                             HelpText. -->
                        <Button x:Name="CompletionDonateButton" Style="{StaticResource AccentPill}"
                                Visibility="{Binding Completion.AsksForDonation, Converter={StaticResource BoolToVis}}"
                                Command="{Binding Completion.DonateCommand}"
                                HorizontalAlignment="Center"
                                MinHeight="48" Padding="40,10"
                                Margin="{StaticResource GapBottom.Sm}"
                                ToolTipService.InitialShowDelay="0"
                                AutomationProperties.Name="{loc:Translate Automation.Donate}"
                                AutomationProperties.HelpText="{loc:Translate Tooltip.Donate}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Heart}"
                                      Fill="{StaticResource Decoration.Heart}" Stretch="Uniform"
                                      Width="{a11y:TextScaled 14}" Height="{a11y:TextScaled 14}"
                                      VerticalAlignment="Center" Margin="{StaticResource GapRight.Icon}"/>
                                <AccessText Text="{loc:Translate Action.Donate}" VerticalAlignment="Center"
                                            TextWrapping="Wrap" TextAlignment="Center"/>
                            </DockPanel>
                            <Button.ToolTip>
                                <ToolTip x:Name="CompletionDonateFiveToolTip"
                                         Style="{StaticResource AccentTooltip}"
                                         Content="{loc:Translate Tooltip.Donate}"
                                         Placement="Custom"/>
                            </Button.ToolTip>
                        </Button>

                        <Button x:Name="CompletionCloseWithoutDonatingButton" Style="{StaticResource SmallGhostPill}"
                                Visibility="{Binding Completion.AsksForDonation, Converter={StaticResource BoolToVis}}"
                                Content="{loc:Translate Action.CloseWithoutDonating}"
                                ContentTemplate="{StaticResource WrappingCentredLabel}"
                                Command="{Binding Completion.DismissCommand}"
                                IsDefault="True"
                                HorizontalAlignment="Center" Padding="12,0"
                                Margin="{StaticResource GapBottom.Sm}"
                                AutomationProperties.HelpText="{loc:Translate Automation.CloseResult}"/>
                    </StackPanel>

                    <!-- The report box, on the PC's first finished card only and
                         collapsed on every other, with the small "i" beside it that
                         opens the panel saying what the report holds. Whatever the box
                         says as the card closes is what happens. Under the buttons, so
                         Tab reaches the box and then the "i" after them, and the focus
                         placed on the button that closes the card is unchanged; Enter
                         still closes the card with the box focused, a CheckBox not
                         taking Enter, and Space ticks it. Enter and Space on the "i"
                         open and close the panel, a ToggleButton taking both. The box
                         takes the implicit CheckBox style with the muted caption text
                         of the card's lesser lines, set through a style rather than as
                         attributes, so the style's own hover brightening still applies.
                         LiveSetting because the window reads the box out after the
                         outcome lines when the card is revealed. Ticked, the box draws no
                         hairline, its accent fill being its edge, so it does not draw the
                         eye; unticked, it keeps the hairline an empty box needs to be
                         seen. The "i" has no tooltip: it is clicked. -->
                    <Grid x:Name="CompletionReportLine" Grid.Row="4"
                          HorizontalAlignment="Center"
                          Margin="{StaticResource GapTop.Sm}"
                          Visibility="{Binding Completion.OffersReport, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CompletionReportBox"
                                  Content="{loc:Translate Completion.SendReport}"
                                  ContentTemplate="{StaticResource WrappingLabel}"
                                  IsChecked="{Binding Completion.SendsReport}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.LiveSetting="Polite">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                    <Setter Property="FontSize" Value="{DynamicResource Type.Caption}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <chrome:DisclosureButton x:Name="ReportInfoButton" Grid.Column="1"
                                                 Style="{StaticResource InfoButton}"
                                                 IsChecked="{Binding Completion.ReportPanelOpen}"
                                                 VerticalAlignment="Center"
                                                 Margin="{StaticResource GapLeft.Sm}"
                                                 AutomationProperties.Name="{loc:Translate Automation.ReportInfo}"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- The panel the "i" beside the report box opens, saying what the
                 report holds. In the overlay, after the card and drawn over it,
                 rather than in a popup, so it stays on the window and Tab reaches
                 its link straight after the "i". The window sets its bottom margin
                 to sit it just above the report line (PlaceReportPanel); the other
                 margins keep it inside the window, and the text scrolls where the
                 room above the line is shorter than it. Tab reaches the chart's link
                 and then the link to the report window. The background is solid,
                 so a click on the panel never reaches the controls under it. The
                 text keeps FocusRing.Room from the edges of the region it scrolls
                 in, so the focus ring round either link is drawn whole, and the
                 region reaches the same distance into the panel's padding, so the
                 text sits where the padding puts it. -->
            <Border x:Name="ReportPanel"
                    Visibility="{Binding Completion.ReportPanelOpen, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource Surface.Sidebar}"
                    BorderBrush="{StaticResource Action.Standard.Background}"
                    BorderThickness="{StaticResource BorderThickness.Hairline}"
                    CornerRadius="{StaticResource Radius.Panel}"
                    Padding="16,12,16,14"
                    MaxWidth="{a11y:TextScaled 600}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="12"
                    RenderTransformOrigin="0.5,0.5">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource BodyScrollRegion}"
                              Margin="-4"
                              AutomationProperties.Name="{loc:Translate Automation.Scroll.ReportContents}">
                    <StackPanel Margin="4">
                        <!-- Inlines composed in code-behind (BuildReportPanelIntro),
                             the chart's name being a link inside the sentence. -->
                        <TextBlock x:Name="ReportPanelIntroText"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <!-- One line per kind of thing the report carries, filled from
                             code-behind (ReportPanelLines). BulletDecorator sets each dot
                             against the first line of its text, however it wraps. -->
                        <ItemsControl x:Name="ReportPanelList" Focusable="False" IsTabStop="False"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <BulletDecorator Margin="0,1">
                                        <BulletDecorator.Bullet>
                                            <Ellipse Width="{a11y:TextScaled 4}" Height="{a11y:TextScaled 4}"
                                                     Fill="{StaticResource Text.Dim}"/>
                                        </BulletDecorator.Bullet>
                                        <TextBlock Text="{Binding}" Margin="{StaticResource GapLeft.Sm}"
                                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                                   TextWrapping="Wrap"/>
                                    </BulletDecorator>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Translate Completion.ReportPanel.Closing}"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap"/>
                        <!-- The link to the window showing the report itself, on a line
                             of its own, filled from code-behind (BuildReportPanel). -->
                        <TextBlock x:Name="ReportPanelSeeReportText"
                                   Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- The card the window opens with where the check made as the app starts finds
             a newer version, in front of a window showing nothing of the scan: the two
             lines of the notice, Update now or the link where the app cannot update
             itself or the newer version's release rules this copy out, the second line
             then saying why, or in place of both the link to Microsoft's .NET Framework
             4.8 installer where that is why, and Continue without updating, which takes
             the card away and shows the scan. On a copy installed by Scoop, Scoop's update command and Copy take
             Update now's place, with the link under them. After an update that failed it
             carries the line saying what failed and the link under Update now. The same
             dim and card as the scanning overlay; a click on the dim does nothing. The
             code-behind puts the card's lines in the window's spoken name while the card
             is up, and the focus on the card's first step. Esc is Continue
             (MainViewModel.HandleEscape). -->
        <Grid x:Name="UpdateOfferOverlay" Grid.RowSpan="3"
              Visibility="{Binding Chrome.IsOfferingUpdate, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="28,22" MaxWidth="{a11y:TextScaled 480}" Margin="{StaticResource GapX.Xl}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel>
                    <Path Data="{StaticResource Icon.Update}"
                          Stroke="{StaticResource Link.Rest}" StrokeThickness="2" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="{a11y:TextScaled 32}" Height="{a11y:TextScaled 32}" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="{StaticResource GapBottom.Md}"/>
                    <TextBlock Text="{Binding Chrome.UpdateNoticeText}"
                               Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="UpdateOfferDetail" Text="{Binding Chrome.UpdateNoticeDetailText}"
                               Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource GapTop.Sm}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="UpdateOfferFailure" Text="{Binding Chrome.UpdateFailureText}"
                               Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource GapTop.Sm}"
                               Visibility="{Binding Chrome.HasUpdateFailure, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding Chrome.ScoopUpdateLine, Mode=OneWay}"
                               Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource GapTop.Sm}"
                               Visibility="{Binding Chrome.ShowsScoopCommand, Converter={StaticResource BoolToVis}}"/>
                    <!-- The steps one under another, each centred on the card: Update now,
                         the accent marking it as the step the card recommends, or on a copy
                         installed by Scoop, Scoop's update command and Copy, which takes the
                         accent, with the line saying the copy failed under them; the link to
                         the release page, or to Microsoft's .NET Framework 4.8 installer where
                         that is why the card has no Update now, as large as Continue; then
                         Continue without updating. -->
                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="UpdateOfferUpdateNowButton" Style="{StaticResource AccentPill}"
                                Content="{loc:Translate UpdateNotice.UpdateNow}"
                                Command="{Binding Chrome.UpdateNowCommand}"
                                HorizontalAlignment="Center" Margin="0,0,0,8"
                                Visibility="{Binding Chrome.ShowsUpdateNow, Converter={StaticResource BoolToVis}}"/>
                        <chrome:ScoopCommandBox x:Name="UpdateOfferScoopBox" DataContext="{Binding Chrome}"
                                                OnCard="True" AutomationIdPrefix="UpdateOffer"
                                                CopyButtonStyle="{StaticResource AccentPill}"/>
                        <TextBlock FontSize="{DynamicResource Type.Heading.Sm}" FontWeight="Medium"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,8,0,8"
                                   Visibility="{Binding Chrome.ShowsReleaseLink, Converter={StaticResource BoolToVis}}">
                            <Hyperlink x:Name="UpdateOfferDownloadLink"
                                       Command="{Binding Chrome.OpenReleasePageCommand}"
                                       Style="{StaticResource SubtleLink}"
                                       AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.Download}"><Run Text="{loc:Translate UpdateNotice.Download}"/></Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="{DynamicResource Type.Heading.Sm}" FontWeight="Medium"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,8,0,8"
                                   Visibility="{Binding Chrome.ShowsNetFrameworkLink, Converter={StaticResource BoolToVis}}">
                            <Hyperlink x:Name="UpdateOfferNetFrameworkLink"
                                       Command="{Binding Chrome.OpenNetFrameworkDownloadCommand}"
                                       Style="{StaticResource SubtleLink}"
                                       AutomationProperties.Name="{loc:Translate Automation.UpdateNotice.DownloadNetFramework48}"><Run Text="{loc:Translate UpdateNotice.DownloadNetFramework48}"/></Hyperlink>
                        </TextBlock>
                        <Button x:Name="UpdateOfferContinueButton" Style="{StaticResource GhostPill}"
                                Content="{loc:Translate UpdateNotice.ContinueWithoutUpdating}"
                                ContentTemplate="{StaticResource WrappingCentredLabel}"
                                Command="{Binding Chrome.ContinueWithoutUpdatingCommand}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Update overlay: the card shown while Update now downloads the newer version,
             over everything else, the card saying a newer version is available included.
             The same dim and card as the scanning overlay, with a bar that
             measures where the server gives the download's length and moves without
             measuring where it does not, the line naming the version, and Cancel. It
             stays up as the app hands over and closes. The code-behind moves the focus
             to Cancel and reads the line out as the card appears. -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Chrome.IsUpdating, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="28,22" MaxWidth="{a11y:TextScaled 480}" Margin="{StaticResource GapX.Xl}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar MaxWidth="240" Height="8" Margin="{StaticResource GapBottom.Md}"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Chrome.UpdateProgressPercent}"
                                 AutomationProperties.Name="{Binding Chrome.UpdatingText}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="IsIndeterminate" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chrome.IsUpdateProgressKnown}" Value="True">
                                        <Setter Property="IsIndeterminate" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock x:Name="UpdatingText" Text="{Binding Chrome.UpdatingText}"
                               Foreground="{StaticResource Text.Heading}"
                               FontSize="{DynamicResource Type.Heading.Sm}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,16"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="UpdateCancelButton" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.Cancel}" Command="{Binding Chrome.CancelUpdateCommand}"
                            MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                            HorizontalAlignment="Center"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
