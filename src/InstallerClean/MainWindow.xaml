<Window x:Class="InstallerClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:chrome="clr-namespace:InstallerClean.Controls"
        xmlns:a11y="clr-namespace:InstallerClean.Helpers"
        Title="{loc:Translate Window.Main.Title}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Sidebar}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Scan.ScanCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <a11y:InstallerPathTextConverter x:Key="KeepInstallerPathWhole"/>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Star, not Auto: under SizeToContent the star row measures
                 to its content like Auto would, but once this grid's
                 work-area MaxHeight (set in code-behind) binds at large
                 OS text scales the star row is what shrinks, engaging
                 the scan panel's internal ScrollViewer, so the bottom
                 nav below never clips. The cap sits on the grid rather
                 than the window so it constrains the measure pass and
                 the ScrollViewer learns its real budget; a window-level
                 MaxHeight only clamps the arrange. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar. Row 0 height matches WindowChrome.CaptionHeight (32)
             so the icon and the 32px caption buttons share a centerline.
             Left margin (16) matches where the detail windows' title bars
             land (Margin.DetailWindow 24 + StackPanel -8). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="16,0,0,0">
            <chrome:DecorativeImage Source="Assets/splash-icon.png" Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="{StaticResource GapRight.Sm}"/>
            <TextBlock Text="{loc:Translate Window.Main.Title}" Foreground="{StaticResource Text.Body}"
                       FontSize="{StaticResource Type.TitleBar}" FontWeight="Medium"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    Click="MinimizeClick" AutomationProperties.Name="{loc:Translate Automation.Minimise}"
                    ToolTip="{loc:Translate Tooltip.Minimise}"/>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                    Click="CloseClick" AutomationProperties.Name="{loc:Translate Automation.Close}"
                    ToolTip="{loc:Translate Tooltip.Close}"/>
        </StackPanel>

        <!-- Invisible scan-result announcer. Code-behind writes the
             composed "N unneeded files to clean up (size)" line here
             after a scan that found files; the visible count rows carry
             no LiveSetting because they rebind on every refresh,
             including the silent post-operation one. Opacity 0 keeps the
             element in the rendered tree, which the UIA bridge requires
             before it announces a text change. -->
        <TextBlock x:Name="ScanResultAnnouncer" Grid.Row="0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite"/>

        <!-- Row 1: the scan-result panel. The window is NoResize +
             SizeToContent="Height", so it grows to fit this content
             exactly and normally never needs a scrollbar; a tall warning
             banner makes the window taller rather than clipping the
             action buttons. The MaxWidth is the content width an 828
             window gives at 100% text scale and grows with the OS
             text-size factor in step with the explicit scaled window
             width set in code-behind, so the window widens with its
             text instead of starving the counts row.

             Stretch, never Center: a centred column sizes to its
             content, and in the states that collapse the wide elements
             (all-clean and not-yet-scanned, where the move box and the
             long lead are gone) it shrank to the counts grid and
             floated mid-window while the bottom nav stayed at the left
             margin. Stretch holds the column at the cell's width in
             every state, and if the cell ever outgrew MaxWidth a
             clamped stretched element is centred by WPF anyway, so the
             wide-window intent is unchanged. -->
        <Grid Grid.Row="1" Margin="{StaticResource Margin.MainContent}"
              MaxWidth="{a11y:TextScaled 780}" HorizontalAlignment="Stretch"
              IsEnabled="{Binding IsMainContentInteractive}">
            <!-- Three rows, not five with fixed 16 and 12 spacer rows between
                 them: the separator and the action zone collapse together when
                 there is nothing to move or delete, and a fixed spacer row
                 holds its height whatever sits in it, so the collapsed pair
                 would leave 28 pixels of dead space above the bottom nav. The
                 separator carries that spacing in its own margin instead, which
                 goes with it. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Context: scan results. The explanation and counts sit in
                 a star row inside a ScrollViewer (NOT a StackPanel row: a
                 vertical StackPanel measures children at infinite height,
                 so an inner ScrollViewer never engages). When the window's
                 work-area MaxHeight binds at large text scales, this is
                 the block that scrolls; the separator, the action zone and
                 the bottom nav keep their full height below it. -->
            <!-- Negative right margin extends this region's viewport 4px past
                 the content's right edge; the inner StackPanel's matching
                 positive right margin holds the content back at that edge, and
                 its bottom margin grows the content the same 4px below its last
                 element. A ScrollContentPresenter owns an adorner layer clipped
                 to its viewport, so a focus visual (drawn 2px outside its
                 control by the *FocusVisual styles' Margin=-2) on a control
                 flush against the viewport edge is clipped on that side. The
                 left-alone row's "Details" pill sits flush right and, with no
                 missing-from-disk banner below it, flush bottom, so
                 its ring was cut on both; the 4px of viewport headroom clears it
                 while the pill stays aligned with the orphaned row's "Details"
                 and the action buttons at the content edge. -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource BodyScrollRegion}"
                          Margin="0,0,-4,0"
                          AutomationProperties.Name="{loc:Translate Automation.Scroll.ScanResults}">
            <StackPanel Margin="0,0,4,4">

                <!-- Explanatory text in three tiers: the lead reassurance reads
                     prominent (heading tier), the "why" detail recedes (muted),
                     the action line sits at body tier. Three resx keys so each
                     styles independently; the lead and the detail bind to the
                     view-model, which picks them by scan state.

                     The block carries the gap below the intro, not its last
                     child: which child IS last changes with the state, so a
                     bottom margin on any one of them would vanish in the states
                     where it collapses. Its 8 plus the 8 on the last visible
                     line is the 16 the intro has always had under it. -->
                <StackPanel Margin="{StaticResource GapBottom.Sm}">
                    <!-- Inlines are composed in code-behind (BuildIntroLeadLine)
                         so the bracketed phrase in the scanned state's lead
                         renders as a hyperlink into the README's "Is it safe?"
                         section; a TextBlock cannot bind Text and host an
                         inline Hyperlink at once, so there is no Text binding
                         here. The other three leads (not scanned, scan failed,
                         Windows Installer hold) carry no brackets and render
                         verbatim. -->
                    <TextBlock x:Name="IntroLeadText" TextWrapping="Wrap" Foreground="{StaticResource Text.Heading}"
                               FontSize="{DynamicResource Type.Heading.Sm}" Margin="{StaticResource GapBottom.Sm}"/>
                    <!-- The converter prepares the line for layout. It binds the
                         installer cache folder's path together so it cannot wrap
                         mid-path, the line naming the folder in three of its four
                         states, and gives the crash log's path break points at its
                         folders so a long one wraps rather than running off the
                         pane. The collapse trigger below reads the view-model
                         value, not the converted one, so its empty test is
                         unaffected. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Text="{Binding IntroDetail, Converter={StaticResource KeepInstallerPathWhole}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- Collapses on an all-clear, where the lead
                                         says it all; an empty TextBlock would
                                         still carry its line height and margin. -->
                                    <DataTrigger Binding="{Binding IntroDetail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- "Scan cancelled.", shown only in the not-yet-scanned
                         state. No LiveSetting: this window is built after the
                         startup scan has already ended, so there is no text
                         change for the UIA bridge to announce; the code-behind
                         speaks it through ScanResultAnnouncer instead. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Text="{Binding IntroNotice}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntroNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Action line hidden when a pending reboot holds Move and
                         Delete (bound to ShowMainAction, not Scan.HasOrphans): the
                         buttons are dead then, so an instruction to press them
                         reads as a broken app. The banner and the reworded lead
                         explain the hold instead. -->
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}" Margin="{StaticResource GapBottom.Sm}"
                               Visibility="{Binding ShowMainAction, Converter={StaticResource BoolToVis}}"
                               Text="{loc:Translate Body.MainExplanation.Action}"/>
                </StackPanel>

                <!-- Pending reboot warning (Phosphor fill, tweaked !). DockPanel
                     (not a horizontal StackPanel) so the message wraps: a
                     horizontal StackPanel gives its child infinite width,
                     defeating TextWrapping and clipping the longer advisory
                     sentences off the right edge. Icon docks left and aligns to
                     the first line; the TextBlock fills the rest and wraps.

                     The text takes Type.Body, the token that goes with the
                     Text.Body role it already carries, and it has to be a size
                     token rather than nothing: the icon beside it is TextScaled,
                     so an unsized TextBlock leaves the warning growing with the
                     OS text-size setting while the sentence it belongs to stays
                     put. The missing-from-disk footnote further down pairs
                     Text.Muted with Type.Caption for the same reason. -->
                <DockPanel Margin="{StaticResource GapBottom.Lg}"
                           Visibility="{Binding Scan.HasPendingReboot, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <!-- LiveSetting=Polite + code-behind RaiseAutomationEvent
                         on the false→true HasPendingReboot transition.
                         The WPF UIA bridge has historically not re-
                         fired LiveRegionChanged when an element enters
                         the tree from Visibility=Collapsed; the bridge
                         only re-announces a text change inside an
                         already-rendered subtree. Code-behind raises
                         LiveRegionChanged explicitly so the banner's
                         appearance is announced. -->
                    <TextBlock x:Name="PendingRebootBannerText"
                               Text="{Binding Scan.PendingRebootBannerText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Body}"
                               FontSize="{DynamicResource Type.Body}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>

                <!-- Rule under the intro (and the pending-reboot warning when
                     shown): marks the explanation as its own section above the
                     scan counts. Matches the separator below the left-alone
                     count. Collapses with the counts it introduces: before the
                     first scan there are no counts, and a rule with nothing
                     under it is a stray line. -->
                <chrome:DecorativeBorder BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="0,1,0,0" Margin="{StaticResource GapBottom.Lg}"
                                         Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}"/>

                <!-- Unneeded (orphaned) count: the loud heading-tier row leads
                     the scan results, sitting above the quiet left-alone row
                     so position agrees with the existing emphasis. Both count
                     rows hang off HasScanned: "0 unneeded files" and "0 files
                     left alone" are a scan result, and printing them before
                     any scan has run tells a user who cancelled the startup scan
                     that their machine is clean. -->
                <Grid Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Wraps for the same width-clamp reason as the
                         left-alone line below. -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                               TextWrapping="Wrap"
                               Text="{Binding Scan.OrphanedSummaryText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Scan.OrphanedSizeDisplay}"
                               Foreground="{StaticResource Text.Heading}" FontSize="{DynamicResource Type.Heading.Sm}"
                               VerticalAlignment="Center" MinWidth="{a11y:TextScaled 72}" TextAlignment="Right"
                               Margin="{StaticResource GapX.Md}"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.Details}" Command="{Binding Chrome.OpenOrphanedDetailsCommand}"
                            MinHeight="28" Padding="12,0" FontSize="{DynamicResource Type.Heading.Sm}"
                            VerticalAlignment="Center" Margin="{StaticResource GapLeft.Md}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            AutomationProperties.Name="{loc:Translate Automation.ViewOrphanedFiles}"
                            AutomationProperties.HelpText="{loc:Translate Automation.ViewOrphanedFiles.HelpText}"/>
                </Grid>

                <!-- The quiet left-alone row sits a small gap (GapTop.Sm)
                     below the loud unneeded row above. -->
                <Grid Margin="{StaticResource GapTop.Sm}"
                      Visibility="{Binding Scan.HasScanned, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left alone. Wraps so a work-area width clamp at
                         large text scales shortens the line instead of
                         clipping it against the size column. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Heading.Sm}"
                               TextWrapping="Wrap"
                               Text="{Binding Scan.RegisteredSummaryText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Scan.RegisteredSizeDisplay}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Heading.Sm}"
                               VerticalAlignment="Center" MinWidth="{a11y:TextScaled 72}" TextAlignment="Right"
                               Margin="{StaticResource GapX.Md}"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.Details}" Command="{Binding Chrome.OpenRegisteredDetailsCommand}"
                            MinHeight="28" Padding="12,0" FontSize="{DynamicResource Type.Heading.Sm}"
                            VerticalAlignment="Center" Margin="{StaticResource GapLeft.Md}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            AutomationProperties.Name="{loc:Translate Automation.ViewRegisteredFiles}"
                            AutomationProperties.HelpText="{loc:Translate Automation.ViewRegisteredFiles.HelpText}"/>
                </Grid>

                <!-- FIRST OF THE TWO HELD-BACK FOOTNOTES, AND THEY ARE ADJACENT
                     BECAUSE THEY ARE ONE SENTENCE ABOUT TWO POPULATIONS. This line and
                     the one below it each open on what the scan could not establish
                     and close on what it held back, and carry the same italic caption
                     treatment with no icon on either: one rule reaching the walk side
                     and the registered side of the same scan. A reader meets them as a
                     pair or not at all.

                     THE WARNING GOES UNDER BOTH, and it is the only line in the block
                     carrying something to act on, so it ends up nearest the buttons.
                     Its own note places it under the left-alone count, which is where
                     it now is.

                     WHAT THIS ONE SAYS AND WHY IT HAS TO. The explanation at the top of
                     this window states two criteria for listing a file, and on this
                     machine the first one did not run: files no program claims are in
                     that folder and were held back rather than listed, so a reader
                     taking that explanation as the rule behind the list concludes there
                     were none of them.

                     Same low-emphasis treatment as the two below and the same Polite
                     live setting, being a fact about the scan rather than something to
                     act on. It cannot appear on the all-clear, and its own count is
                     what does that rather than the screen in front of it: the
                     completion screen is dismissible, so a line left switched on would
                     be read on the window underneath. -->
                <TextBlock x:Name="NothingListedText"
                           Visibility="{Binding Scan.HasNothingListed, Converter={StaticResource BoolToVis}}"
                           Text="{Binding Scan.NothingListedText}"
                           Foreground="{StaticResource Text.Muted}"
                           FontStyle="Italic" FontSize="{DynamicResource Type.Caption}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapTop.Sm}"
                           AutomationProperties.LiveSetting="Polite"/>

                <!-- Superseded files this scan held back (informational), and the
                     pair of the line directly above rather than a different kind of
                     line: the same sentence about the other half of the scan. The app could
                     not establish that nothing still needed them, so it kept them.
                     Same low-emphasis treatment as the line above and for the same
                     reason, nothing being wrong with the machine and there being
                     nothing for the user to do.

                     IT NAMES NO CAUSE, AND THE STRING'S OWN REMARKS CARRY WHY: six
                     separate findings reach this count, so a sentence naming one of
                     them is false of the files the other five contribute.

                     GATED ON THE COUNT IT PRINTS. It was gated on the count of
                     products the scan could not account for, which is the trigger for
                     one of those six routes rather than a count of files at all, so it
                     could appear on a machine that had held nothing back and tell its
                     owner otherwise. -->
                <TextBlock x:Name="SupersededHeldBackText"
                           Visibility="{Binding Scan.HasSupersededHeldBack, Converter={StaticResource BoolToVis}}"
                           Text="{Binding Scan.SupersededHeldBackText}"
                           Foreground="{StaticResource Text.Muted}"
                           FontStyle="Italic" FontSize="{DynamicResource Type.Caption}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapTop.Sm}"
                           AutomationProperties.LiveSetting="Polite"/>

                <!-- Registered files missing from disk. Sits as a footnote
                     under the left-alone count: a missing file is one of the
                     needed files, Windows still expects it, it just isn't on
                     disk. DockPanel (not a horizontal StackPanel) so the
                     advisory wraps; icon docks left, aligned to the first line.

                     LAST OF THE THREE, BECAUSE IT IS THE ONLY ONE WITH ANYTHING TO
                     DO IN IT. The two held-back lines above are facts about the scan
                     and stay together; this one names programs whose update or
                     uninstall can fail, so it sits closest to the buttons and it is
                     the line the amber icon marks out.

                     The text takes Type.Caption, as the two footnotes above it
                     do, and it has to be a size token rather than
                     nothing: the icon beside it is TextScaled, so an unsized
                     TextBlock leaves the warning growing with the OS text-size
                     setting while the sentence it belongs to stays put. -->
                <DockPanel Margin="{StaticResource GapTop.Sm}"
                           Visibility="{Binding Scan.HasMissingFromDisk, Converter={StaticResource BoolToVis}}">
                    <Path Data="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM118,98a10,10,0,0,1,20,0v46a10,10,0,0,1,-20,0Zm10,96a14,14,0,1,1,14,-14A14,14,0,0,1,128,194Z"
                          Fill="{StaticResource Status.Warning}" Stretch="Uniform"
                          Width="{a11y:TextScaled 16}" Height="{a11y:TextScaled 16}"
                          DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapRight.Icon}"/>
                    <TextBlock x:Name="MissingFromDiskBannerText"
                               Text="{Binding Scan.MissingFromDiskSummaryText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Caption}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>




            </StackPanel>
            </ScrollViewer>

            <!-- Separator. It carries the 16 above and 12 below in its own
                 margin so the spacing collapses with it; fixed spacer rows
                 hold their height whatever sits in them. -->
            <chrome:DecorativeBorder Grid.Row="1" BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="0,1,0,0"
                                     Margin="0,16,0,12"
                                     Visibility="{Binding ShowActionZone, Converter={StaticResource BoolToVis}}"/>

            <!-- Action zone: move/delete -->
            <Grid Grid.Row="2"
                  Visibility="{Binding ShowActionZone, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Backup folder label -->
                <TextBlock Grid.Row="0" Text="{loc:Translate Section.Backup.Folder}"
                           Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Heading.Sm}"
                           AutomationProperties.Name="{loc:Translate Automation.Section.BackupFolder}"/>

                <!-- Move destination -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The placeholder is the box's Tag, rendered inside the
                         PillTextBox template so it lines up with the caret;
                         there is no separate tooltip: the placeholder
                         carries the what and the why.

                         Tag text is drawn by the template and reaches no
                         screen reader, so the same key is also the box's
                         HelpText. It is deliberately one key feeding both:
                         the hint a screen reader hears and the hint on
                         screen are the same sentence by construction and
                         cannot drift apart, which is the failure two
                         separate strings produce. -->
                    <TextBox Grid.Column="0" x:Name="MoveDestinationInput" Style="{StaticResource PillTextBox}"
                             Text="{Binding Cleanup.MoveDestination, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="8192"
                             Tag="{loc:Translate Action.BackupFolderPlaceholder}"
                             AutomationProperties.Name="{loc:Translate Automation.BackupFolder}"
                             AutomationProperties.HelpText="{loc:Translate Action.BackupFolderPlaceholder}"/>

                    <Button Grid.Column="2" Style="{StaticResource GhostPill}" Padding="12,8"
                            Content="{loc:Translate Action.Browse}" Command="{Binding Cleanup.BrowseDestinationCommand}"/>
                </Grid>

                <!-- Buttons row. Move is the emphasised action, on the accent
                     pill in the rightmost slot; Delete permanently is the quiet
                     one to its left, on the standard pill.

                     The emphasis is not a warning and there is no red anywhere
                     on this screen. The window's first line says these files are
                     safe to delete, and red would be the one element arguing
                     with it. What emphasising Move does carry is a nudge
                     towards prudence, and that was weighed and accepted rather
                     than arrived at: move if you can, for peace of mind, delete
                     if you would rather take the app at its word or are in a
                     hurry. Both are ordinary outcomes and the screen treats
                     them as such.

                     Dock="Right" gives the first declared child the
                     furthest-right slot, so Move is declared first and Delete
                     takes the one to its left, carrying the gap between the
                     two.

                     TabIndex pins MOVE first, and the principle behind it is
                     older than this arrangement: the primary action is the one
                     a keyboard reaches first. Delete held that place while
                     Delete was the emphasised button, so moving it to Move
                     keeps the principle rather than dropping it. The cost was
                     weighed and taken: tab order no longer agrees with
                     left-to-right visual order, so a sighted keyboard user sees
                     focus land on the right-hand button first. Against that, a
                     screen-reader user meets the recommended action first,
                     which is the emphasis this screen now carries on purpose. -->
                <!-- Each button's help text is its own tooltip, not a second
                     sentence written alongside it. Two sources for one
                     explanation drift apart, leaving the screen saying one
                     thing and a screen reader another; one value feeding both
                     cannot, which is the same reasoning the move-destination
                     box's placeholder carries above. Move's is the view-model
                     property because its tooltip has three states, and the
                     state a screen reader needs most is the one that warns a
                     folder browser opens first. -->
                <DockPanel Grid.Row="4" KeyboardNavigation.TabNavigation="Local">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}"
                            KeyboardNavigation.TabIndex="0"
                            Content="{loc:Translate Action.Move}" Command="{Binding Cleanup.MoveAllCommand}"
                            AutomationProperties.HelpText="{Binding Cleanup.MoveButtonTooltip}"
                            ToolTip="{Binding Cleanup.MoveButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True"/>

                    <Button DockPanel.Dock="Right" Style="{StaticResource StandardPill}"
                            KeyboardNavigation.TabIndex="1"
                            Content="{loc:Translate Action.DeletePermanently}" Command="{Binding Cleanup.DeleteAllCommand}"
                            AutomationProperties.HelpText="{loc:Translate Tooltip.Delete}"
                            ToolTip="{loc:Translate Tooltip.Delete}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="{StaticResource GapRight.Sm}"/>

                    <!-- LiveSetting is on the overlay's matching line
                         (the load-bearing surface during an operation);
                         this body-row line sits behind the operating
                         overlay during the only window where the text
                         is changing, so re-announcing here doubles every
                         progress callback for screen readers. -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Cleanup.OperationProgress}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Body}"
                               TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 280}"/>
                </DockPanel>
            </Grid>

        </Grid>

        <!-- Bottom nav. Asymmetric Margin: 4 left because Re-scan
             and About are GhostPills with their own internal padding;
             24 right for clearance between the right-anchored chrome
             icons and the window-close hit area above. One-off;
             a literal Thickness rather than a Gap token. -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="4,8,24,8"
                   KeyboardNavigation.TabNavigation="Local"
                   IsEnabled="{Binding IsMainContentInteractive}">
            <!-- Help text matches the completion overlay's "Scan again", which
                 runs the same command: the two are one action with two labels,
                 so an explanation on only one of them is drift. -->
            <Button x:Name="RescanButton" DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="0"
                    Content="{loc:Translate Action.Rescan}" Command="{Binding Scan.ScanCommand}"
                    AutomationProperties.HelpText="{loc:Translate Automation.RescanInstaller}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="1"
                    Content="{loc:Translate Action.About}" Command="{Binding Chrome.ShowAboutCommand}" Margin="4,0,0,0"/>
            <!-- Manual update check. The automatic once-per-session check
                 fires at launch without a click; this button is for anyone
                 who wants to ask again, and it is the only control that
                 reports an up-to-date result or a failure, because the
                 automatic path is deliberately silent on both. Its own
                 execution covers the cooldown, so the pill's disabled paint
                 is the feedback while it runs. -->
            <Button x:Name="UpdateCheckButton" DockPanel.Dock="Left" Style="{StaticResource GhostPill}"
                    KeyboardNavigation.TabIndex="2"
                    Content="{loc:Translate Action.CheckForUpdates}"
                    Command="{Binding Chrome.CheckForUpdatesCommand}" Margin="4,0,0,0"
                    Click="UpdateCheckButton_Click"
                    IsEnabledChanged="UpdateCheckButton_IsEnabledChanged"
                    AutomationProperties.Name="{loc:Translate Automation.CheckForUpdates}"
                    AutomationProperties.HelpText="{loc:Translate Automation.CheckForUpdates.HelpText}"/>
            <!-- Language switcher: a wordless globe so it reads in any UI
                 language. It opens a menu of language names (endonyms) with
                 the running one ticked (LanguageButton_Click); picking
                 another restarts the app into it. Declared before the status
                 line below (which docks Left) so the DockPanel reserves its
                 slot at the far right first and the status line takes only
                 what is left between the buttons and the globe, which is
                 also what gives the status line a width to ellipsize
                 against. TabIndex 4 puts it last in the bar's reading order,
                 after the status hyperlink at 3, rather than at its
                 declaration position. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostPill}"
                    x:Name="LanguageButton"
                    KeyboardNavigation.TabIndex="4"
                    Click="LanguageButton_Click"
                    AutomationProperties.Name="{loc:Translate Automation.ChangeLanguage}"
                    AutomationProperties.HelpText="{loc:Translate Automation.ChangeLanguage.HelpText}"
                    ToolTipService.InitialShowDelay="0"
                    ToolTip="{loc:Translate Tooltip.ChangeLanguage}">
                <!-- The globe is the whole button, so it is what carries the OS
                     text size here: SmallGhostPill's 28 is a minimum height and
                     a wordless button has no label to push past it, which left
                     this and the completion heart the two smallest targets in
                     the app at exactly the scale where everything else had
                     doubled. The stroke stays 2: Shape applies Stretch to the
                     geometry and the pen after it, so the outline holds its
                     weight as the circle grows, which is what a line drawing
                     wants. -->
                <Path Data="M2 12 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0 M12 2 a4.2 10 0 1 0 0 20 a4.2 10 0 1 0 0 -20 M2 12 h20"
                      Stroke="{StaticResource Text.Muted}" StrokeThickness="2" Fill="{x:Null}"
                      Width="{a11y:TextScaled 18}" Height="{a11y:TextScaled 18}" Stretch="Uniform"/>
            </Button>
            <!-- Update status line, in two mutually exclusive
                 presentations of the same sentence. Both dock Left after the
                 globe so they take the space between the buttons and the
                 globe, which is also what gives them a width to ellipsize
                 against; both are live regions so an outcome that arrives
                 while focus is elsewhere is still spoken (the automatic
                 check lands unprompted, so it always is).

                 They differ on LiveSetting, and it is the transience that
                 decides it. The plain line is Assertive: a manual check
                 answers within a second or two of the click, while the
                 screen reader is typically still reading the button's own
                 name and help text, and a polite item raised behind that
                 loses its turn and is gone (the line clears itself after the
                 cooldown), so "Up to date." goes unspoken. What makes
                 interrupting acceptable is that only the manual check ever
                 paints this line: the automatic one sets the link first and
                 so takes the other presentation, which means an assertive
                 cut-in is always the answer to a click, never something
                 unprompted talking over the user. It can still land in the
                 middle of something else they started, because the check
                 disables only its own button and Re-scan stays live for the
                 whole cooldown: press both and "Up to date.", or the clear
                 five seconds later, cuts into the scanning overlay's polite
                 announcements. Accepted, on the same grounds. The window for
                 it is a few seconds wide and the user opened it themselves.
                 The link stays
                 Polite because it does not clear: it is on screen and in the
                 tab order until the user acts on it, so an announcement that
                 waits its turn still arrives at something the user can
                 reach, and interrupting for it would buy nothing.

                 Plain muted text while there is nothing to click
                 ("Checking...", "Up to date."). A hyperlink once a check has
                 found a newer version, because at that moment the sentence
                 announcing the update is also the way to get it. The link
                 takes the app's one link style, whose indigo is the accent
                 family's only text-legible step: Action.Accent.Background,
                 what the accent pills fill with, measures 2.33:1 against
                 this window's surface and cannot carry type.

                 The plain line's second trigger keys on HasUpdateLink, the
                 view model's bool, which is what makes the two presentations
                 exclusive; why that state is a bool rather than something a
                 DataTrigger would have to interpret is on the property
                 itself. -->
            <TextBlock x:Name="UpdateStatusLineText"
                       DockPanel.Dock="Left" Text="{Binding Chrome.UpdateStatusText}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource Text.Muted}"
                       FontSize="{DynamicResource Type.Body}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Assertive">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Chrome.UpdateStatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Chrome.HasUpdateLink}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="UpdateLinkText" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="{DynamicResource Type.Body}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Chrome.HasUpdateLink, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.LiveSetting="Polite">
                <!-- No AutomationProperties.Name or HelpText: the Run IS the
                     link's accessible name, and it is already a whole
                     sentence naming the version, spoken after the "link"
                     control type. There is nothing left to add that would
                     not be a second reading of the same words. -->
                <Hyperlink Command="{Binding Chrome.OpenUpdatePageCommand}"
                           Style="{StaticResource SubtleLink}"
                           KeyboardNavigation.TabIndex="3"><Run Text="{Binding Chrome.UpdateStatusText}"/></Hyperlink>
            </TextBlock>
        </DockPanel>

        <!-- Scanning overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Scan.IsScanning, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="8" Margin="{StaticResource GapBottom.Md}"
                             AutomationProperties.Name="{loc:Translate Automation.ScanningProgress}"/>
                <TextBlock Text="{Binding Scan.ScanProgress}" Foreground="{StaticResource Text.Heading}"
                           FontSize="{DynamicResource Type.Heading.Sm}" HorizontalAlignment="Center" Margin="{StaticResource GapBottom.Sm}"
                           AutomationProperties.LiveSetting="Polite"/>
                <!-- Per-product ticker: names each package as the
                     enumeration passes it. Display-only; no LiveSetting,
                     because it updates once per installed product and a
                     live region would queue one announcement per product.
                     The milestone line above stays the announced one. -->
                <TextBlock Text="{Binding Scan.ScanTicker}"
                           Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                           HorizontalAlignment="Center" Margin="{StaticResource GapBottom.Lg}"
                           TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 240}"/>
                <Button x:Name="ScanCancelButton" Style="{StaticResource GhostPill}"
                        Content="{loc:Translate Action.Cancel}" Command="{Binding Scan.CancelScanCommand}"
                        MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                        HorizontalAlignment="Center"
                        FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                        AutomationProperties.Name="{loc:Translate Automation.CancelScan}"/>
            </StackPanel>
        </Grid>

        <!-- Operating overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Cleanup.IsOperating, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"/>
            <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    Padding="28,22" MinWidth="260"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Code-behind raises LiveRegionChanged on this heading when
                         the overlay appears. The UIA bridge announces neither a
                         Collapsed-to-Visible reveal nor a text change inside a
                         collapsed subtree, so the view-model assigns the heading
                         before IsOperating reveals the overlay and that raise is
                         the only path that speaks. Assigned after the reveal, the
                         text change also fires the bridge once the heading's peer
                         exists from an earlier operation, and the heading is
                         spoken twice. -->
                    <TextBlock x:Name="OperationHeadingText"
                               Text="{Binding Cleanup.OperationProgress}" Foreground="{StaticResource Text.Heading}"
                               FontSize="{DynamicResource Type.Heading.Sm}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="{StaticResource GapBottom.Lg}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <!-- Indeterminate for the rescan after a cancel, where there
                         is no per-file progress to report and a filled bar would
                         be describing the batch that has just stopped. The count
                         row and the filename below go with it, on the same
                         binding, so the card is a heading and a moving bar,
                         which is what the scanning overlay above already is. -->
                    <ProgressBar Value="{Binding Cleanup.OperationProgressPercent}"
                                 IsIndeterminate="{Binding Cleanup.IsOperationProgressIndeterminate}"
                                 Minimum="0" Maximum="100"
                                 Width="200" Height="8" Margin="{StaticResource GapBottom.Sm}"
                                 AutomationProperties.Name="{loc:Translate Automation.OperationProgress}"/>
                    <!-- The 0,0,0,2 here and the 0,4,0,0 on the filename below sit
                         off the 8/12/16/24 spacing scale on purpose: they tighten
                         the "X of Y" / percentage row and the filename into one
                         compact block under the progress bar, where the scale's
                         8px would loosen the grouping. -->
                    <DockPanel Margin="0,0,0,2"
                               Visibility="{Binding Cleanup.ShowOperationProgressDetail, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}">
                            <Run Text="{Binding Cleanup.OperationProgressPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}"/>
                        </TextBlock>
                        <Grid>
                            <!-- Visible count: updates once per file. No
                                 LiveSetting; on a LiveSetting element every
                                 text change is announced, so a per-file
                                 binding queues one announcement per file and
                                 a large batch floods the speech queue. -->
                            <TextBlock Text="{Binding Cleanup.OperationProgressDetail}"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="{DynamicResource Type.Caption}"/>
                            <!-- Screen-reader twin: the same "X of Y files"
                                 line, updated at most once per tenth of the
                                 batch (first and last file always), so the
                                 announcements keep pace with speech. Opacity
                                 0 keeps it in the rendered tree, which the
                                 UIA bridge requires before it announces a
                                 text change, without painting over the live
                                 count. -->
                            <TextBlock Text="{Binding Cleanup.OperationProgressAnnouncement}"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="{DynamicResource Type.Caption}"
                                       Opacity="0" IsHitTestVisible="False"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </DockPanel>
                    <!-- LiveSetting deliberately absent: the per-file
                         filename changes at I/O speed and would flood
                         the screen-reader queue faster than the user
                         can drain it. The throttled twin above carries
                         the "X of Y" count for the SR. -->
                    <TextBlock Text="{Binding Cleanup.OperationCurrentFileName}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Caption}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="{a11y:TextScaled 240}"
                               Visibility="{Binding Cleanup.ShowOperationProgressDetail, Converter={StaticResource BoolToVis}}"/>
                    <!-- Cancel button binds IsEnabled via the
                         CanCancelOperation predicate so a second click
                         after the cancel-in-flight is dropped. The
                         tooltip set by the IsCancellationRequested
                         trigger explains the disabled state during the
                         several-second window between Cancel and the
                         next CancellationToken checkpoint, mirroring
                         the splash window's pattern. -->
                    <Button x:Name="OperationCancelButton" Content="{loc:Translate Action.Cancel}"
                            Command="{Binding Cleanup.CancelOperationCommand}"
                            AutomationProperties.Name="{loc:Translate Automation.CancelOperation}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            HorizontalAlignment="Center" Margin="{StaticResource GapTop.Sm}"
                            MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostPill}">
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                <Style.Triggers>
                                    <!-- HelpText alongside the ToolTip, from
                                         the same key: a WPF ToolTip opens on
                                         hover and never on keyboard focus, so
                                         without it the one sentence explaining
                                         a button that has just gone dead
                                         reaches a mouse user only. -->
                                    <DataTrigger Binding="{Binding Cleanup.IsCancellationRequested}" Value="True">
                                        <Setter Property="ToolTip" Value="{loc:Translate Tooltip.CancellingPending}"/>
                                        <Setter Property="AutomationProperties.HelpText" Value="{loc:Translate Tooltip.CancellingPending}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Completion overlay. TabNavigation="Cycle" traps Tab
             inside the overlay. 1px BorderBrush matches the confirm
             dialogs. -->
        <Grid x:Name="CompletionOverlay" Grid.RowSpan="3" Visibility="{Binding Completion.IsComplete, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <!-- Clicking the dim margin dismisses the overlay (the
                 inner Border absorbs its own clicks). -->
            <chrome:DecorativeBorder Background="{StaticResource Surface.Overlay}"
                       MouseLeftButtonDown="CompletionDimAreaClick"
                       Cursor="Arrow"/>
            <!-- Card width scales with the OS text size so the copy keeps
                 its line length instead of wrapping into a tall sliver. -->
            <Border Background="{StaticResource Surface.Card}" CornerRadius="{StaticResource Radius.Pill}"
                    BorderBrush="{StaticResource Action.Standard.Background}" BorderThickness="{StaticResource BorderThickness.Hairline}"
                    Padding="36,32" MinWidth="{a11y:TextScaled 340}" MaxWidth="{a11y:TextScaled 520}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Grid, not a StackPanel: the icon, heading and buttons
                     sit in Auto rows and the variable-length copy in a
                     star row, so when the card runs out of window height
                     at large text scales the copy scrolls and the buttons
                     stay visible. A vertical StackPanel would measure at
                     infinite height and clip the buttons instead. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon -->
                    <chrome:DecorativeImage Grid.Row="0" Source="Assets/splash-icon.png"
                           Width="64" Height="64" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="{StaticResource GapBottom.Lg}"/>

                    <!-- Heading. Wraps rather than clipping: it is a translated
                         sentence, in every language the app ships, inside a card
                         of bounded width, and unwrapped it runs off both ends.

                         Foreground is set through the Style, not as an
                         attribute, because an attribute is a local value and a
                         local value beats a trigger's setter: with the inline
                         Foreground still there the warning colour would never
                         paint, whatever HeadingIsWarning said. Green is the
                         default; the warning amber is for the one outcome where
                         nothing succeeded. -->
                    <TextBlock x:Name="CompletionHeadingText" Grid.Row="1" Text="{Binding Completion.Heading}"
                               FontSize="{DynamicResource Type.Heading.Lg}" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="{StaticResource GapBottom.Sm}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.HeadingIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource BodyScrollRegion}"
                                  AutomationProperties.Name="{loc:Translate Automation.Scroll.ResultDetails}">
                    <StackPanel>

                    <!-- Failure count. Its own line, directly under the heading
                         and above the summary, so the heading carries one
                         message and the summary's destination path is never
                         followed by an error count that reads as part of the
                         folder name. Empty (and collapsed) on every run that
                         failed at nothing, which is nearly all of them.
                         LiveSetting because after the outcome itself this is
                         the next thing a screen-reader user needs. -->
                    <TextBlock x:Name="CompletionFailedCountText"
                               Text="{Binding Completion.FailedCount}"
                               Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Heading.Sm}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Sm}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.FailedCount}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 6px bottom (off the 8/12/16/24 scale) tightens
                         the summary against the caption that follows
                         (the reassurance on an all-clear, the restore
                         hint after a Move or Delete); GapBottom.Sm (8)
                         loosens the pairing visibly. Inlines are composed
                         in code-behind (BuildCompletionSummaryLine) so a
                         Move's destination path always starts its own
                         line, at whatever point it substitutes into the
                         formatted sentence for the current language; a
                         plain Text binding cannot force a line break at a
                         dynamic position, so there is no Text binding
                         here. -->
                    <TextBlock x:Name="CompletionSummaryText"
                               Foreground="{StaticResource Text.Body}" FontSize="{DynamicResource Type.Heading.Sm}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               AutomationProperties.LiveSetting="Polite">
                        <!-- Collapses when Summary is empty, which an operation
                             that acted on no file at all leaves it: the summary
                             would otherwise say files went somewhere none did.
                             Without the trigger an empty TextBlock still holds
                             its bottom margin and line height, so the daft line
                             becomes a phantom gap, the same reason the restore
                             and skipped blocks below carry one. The trigger
                             reads Completion.Summary even though the visible
                             inlines are composed in code-behind. -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Summary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Restore guidance, after a Move and on the all-clear
                         receipt. Collapses when empty, so the card does
                         not carry a phantom 30+ pixel gap from the bottom margin
                         plus line-height of an empty TextBlock. Pattern matches
                         the Errors Border below.
                         LiveSetting + the code-behind raise on reveal: this
                         line is the second half of the outcome (where the files
                         went after a Move; the scan receipt on an all-clear).
                         Inlines are composed in code-behind
                         (BuildCompletionRestoreLine), which renders a
                         bracketed phrase as a hyperlink to the README's "Is it
                         safe?" section; a TextBlock cannot bind Text and host
                         an inline Hyperlink at once, so there is no Text
                         binding here. Whether a line links is the value's
                         decision and a translation makes it per language, so
                         the split reads whatever it is given rather than a
                         list of keys. The collapse trigger still reads
                         Completion.Restore. -->
                    <TextBlock x:Name="CompletionRestoreText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Xl}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Restore}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Re-verify skipped note. Shown when the act-time re-check
                         kept some candidates back because a program needs them
                         again since the scan; empty (and collapsed) otherwise.
                         LiveSetting so it is announced with the outcome. -->
                    <TextBlock x:Name="CompletionSkippedText"
                               Text="{Binding Completion.Skipped}"
                               Foreground="{StaticResource Text.Muted}" FontSize="{DynamicResource Type.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom.Xl}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Skipped}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Error details (only visible when there are errors).
                         160 rather than 80: at 80 the box showed about two
                         lines, so a single group heading and one filename
                         filled it and everything else was behind a scrollbar.
                         It still scrolls internally and the card's own scroll
                         region backs it up, so a hundred failures cannot push
                         the buttons off screen. -->
                    <Border Margin="{StaticResource GapBottom.Xl}" MaxHeight="{a11y:TextScaled 160}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.Errors}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Named so the tab stop reads as a labelled field; an
                             unnamed read-only TextBox announces a bare "edit,
                             read-only" with no hint of what the text is. -->
                        <TextBox Text="{Binding Completion.Errors, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 AutomationProperties.Name="{loc:Translate Automation.CompletionErrors}"
                                 Foreground="{StaticResource Status.Warning}" FontSize="{DynamicResource Type.Caption}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Closes the result overlay, NOT the app: exiting
                         from here would trap the user with no way to
                         re-scan or open About. Focused on overlay show so a
                         keyboard user lands on the dismiss action with a
                         visible ring; Enter follows from IsDefault and Esc
                         from the window's own key handler, so neither needs
                         the focus. -->
                    <Button x:Name="CompletionCloseButton" Grid.Row="3" Style="{StaticResource AccentPill}"
                            Content="{loc:Translate Action.Done}" Command="{Binding Completion.DismissCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Center" MinWidth="120"
                            Margin="{StaticResource GapBottom.Sm}"
                            AutomationProperties.HelpText="{loc:Translate Automation.CloseResult}"/>

                    <!-- Send-result-log button. Two locks hide it, and they
                         are deliberately asymmetric: the session lock closes
                         it on any click outcome, success or failure, while
                         only a successful send persists
                         AppSettings.HasSentResultLog and keeps it hidden in
                         later sessions. A transient failure therefore costs
                         one prompt, not the machine's only chance to send.
                         FocusVisualStyle is set explicitly so this
                         GhostPill paints a ring under Tab navigation. -->
                    <Button Grid.Row="4" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.SendResultLog}"
                            Command="{Binding Completion.SendResultLogCommand}"
                            Visibility="{Binding Completion.IsSendResultLogVisible, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                            Margin="{StaticResource GapBottom.Sm}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            ToolTip="{Binding Completion.SendResultLogTooltip}"
                            AutomationProperties.HelpText="{Binding Completion.SendResultLogTooltip}"/>

                    <!-- Result-log status line. Shows "Sending..." while
                         the POST is in flight, "Thanks!" after a success,
                         or a localised failure reason. Empty (and so
                         collapsed) at every other moment.
                         AutomationProperties.LiveSetting=Polite makes
                         screen readers announce text changes here even
                         though focus is on Done; otherwise the silent-
                         skip and post-POST status copy is invisible to
                         users on Narrator/NVDA/JAWS. -->
                    <TextBlock x:Name="ResultLogStatusText" Grid.Row="5"
                               Text="{Binding Completion.ResultLogStatusMessage}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Type.Body}"
                               TextWrapping="Wrap" MaxWidth="{a11y:TextScaled 380}"
                               Margin="{StaticResource GapBottom.Sm}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Completion.ResultLogStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Scan again -->
                    <Button Grid.Row="6" Style="{StaticResource GhostPill}"
                            Content="{loc:Translate Action.ScanAgain}" Command="{Binding Completion.RescanAfterCompletionCommand}"
                            HorizontalAlignment="Center"
                            MinHeight="28" Padding="16,0" FontSize="{DynamicResource Type.Body}"
                            FocusVisualStyle="{StaticResource SmallPillFocusVisual}"
                            AutomationProperties.HelpText="{loc:Translate Automation.RescanInstaller}"/>

                    <!-- Donate heart. Spans every row and pins itself to the
                         card's bottom-right corner, so it sits level with
                         "Scan again" without taking a row of its own or
                         shifting anything when it is absent. Shown only when
                         the run actually moved or deleted files
                         (Completion.ShowDonate), so the ask only ever follows
                         work done; a same-drive Move reclaims no space and
                         still earns it.

                         Declared last so it is the final stop in the
                         overlay's Tab cycle: the named actions the user came
                         for are reached first, and nothing in the card
                         carries an explicit TabIndex, so declaration order is
                         the order.

                         Hover text is invisible to a screen reader, which is
                         why the same sentence is also the HelpText; the Name
                         says what the control does and the HelpText carries
                         the ask. -->
                    <Button Grid.Row="0" Grid.RowSpan="7" Style="{StaticResource SmallGhostPill}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding Completion.ShowDonate, Converter={StaticResource BoolToVis}}"
                            Command="{Binding Chrome.DonateCommand}"
                            ToolTipService.InitialShowDelay="0"
                            AutomationProperties.Name="{loc:Translate Automation.BuyMeACuppa}"
                            AutomationProperties.HelpText="{loc:Translate Completion.DonateAsk}">
                        <!-- Scaled for the reason the language globe is: the
                             heart is all this button has, so without it the ask
                             shrinks against everything around it. -->
                        <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                              Fill="{StaticResource Decoration.Heart}" Stretch="Uniform"
                              Width="{a11y:TextScaled 18}" Height="{a11y:TextScaled 18}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <!-- Hover grow honours "show animations": the scale
                                             plays only while ReduceMotion is false, so an
                                             animation-off user gets a static icon. IsMouseOver
                                             and the live setting gate it together, and a
                                             runtime toggle re-evaluates because ReduceMotion
                                             raises PropertyChanged. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding Source={x:Static a11y:AccessibilitySettings.Current}, Path=ReduceMotion}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1.2" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1.2" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1.0" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1.0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Button.ToolTip>
                            <ToolTip x:Name="CompletionDonateToolTip"
                                     Style="{StaticResource AccentTooltip}"
                                     Content="{loc:Translate Completion.DonateAsk}"
                                     Placement="Custom"/>
                        </Button.ToolTip>
                    </Button>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
