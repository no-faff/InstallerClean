<!--
    Primitive design atoms (colour only).

    Layering rule: Tokens.xaml maps semantic roles to primitives;
    component styles and window XAML consume the semantic roles, never
    a Primitive.* key directly. If a non-Tokens file references
    Primitive.*, that is a smell to fix.

    XAML resource type-matching: a property consuming
    {StaticResource X} requires X's runtime type to match the property's
    declared type exactly. The XAML resource lookup does not run any
    TypeConverter (ThicknessConverter etc), so a Double resource will
    not satisfy a Thickness setter. Numeric tokens with multiple
    consumer-property types therefore need parallel resources of each
    type (see the line-thickness tokens in Tokens.xaml).
    Inline attribute syntax does run TypeConverters, so
    BorderThickness="1" is fine; only StaticResource lookups have the
    strict-typing rule.

    Naming: <ramp>.<step>. Steps follow Tailwind v3's convention so that
    swapping a primitive for a different shade reads as a numeric move
    (Slate.700 darker than Slate.500). Alpha-blended variants use a
    trailing AlphaNN suffix indicating the intended opacity.

    Tailwind is ancestry here, not a dependency: this is a hand-tuned
    palette and there is nothing to upgrade. Most steps do carry Tailwind
    v3's value for the name they wear, and every step that does not says
    so, so an unannotated one can be trusted as v3's. v4 republished the
    palette in OKLCH with different values; adopting those would restyle
    the app and void every contrast ratio measured in Tokens.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slate ramp. Surface, structure, text. -->
    <Color x:Key="Primitive.Slate.50">#f8fafc</Color>
    <Color x:Key="Primitive.Slate.300">#cbd5e1</Color>
    <Color x:Key="Primitive.Slate.400">#94a3b8</Color>
    <!-- The one slate step that is not Tailwind's: v3's slate-500 is
         #64748b. Hand-tuned lighter; not on the Tailwind ramp. -->
    <Color x:Key="Primitive.Slate.500">#8494a7</Color>
    <Color x:Key="Primitive.Slate.600">#475569</Color>
    <Color x:Key="Primitive.Slate.700">#334155</Color>
    <Color x:Key="Primitive.Slate.800">#1e293b</Color>
    <Color x:Key="Primitive.Slate.900">#0f172a</Color>

    <!-- Custom slate steps used for the hover/pressed states of the
         standard action fill. Sit between Slate.700 and Slate.800; not
         on the Tailwind ramp. -->
    <Color x:Key="Primitive.Slate.700.Hover">#2b3749</Color>
    <Color x:Key="Primitive.Slate.700.Pressed">#232e3d</Color>

    <!-- 38, an odd-looking step, because the value is derived rather than
         chosen: composited over the two surfaces the scrollbar thumb sits
         on it clears the WCAG non-text 3:1 line on both with room to
         spare, where its 20% predecessor reached 1.84:1 on the card. The
         bare minimum is 0x59, which lands on 3.01:1 against the sidebar
         and is too fine a margin to build on. Ratios are on the
         Scrollbar.Thumb token that consumes this. -->
    <Color x:Key="Primitive.Slate.50.Alpha38">#60f8fafc</Color>
    <Color x:Key="Primitive.Slate.50.Alpha50">#80f8fafc</Color>
    <Color x:Key="Primitive.Slate.950.Alpha50">#80020617</Color>

    <!-- Indigo ramp. Accent, CTA, links. -->
    <Color x:Key="Primitive.Indigo.300">#a5b4fc</Color>
    <Color x:Key="Primitive.Indigo.400">#818cf8</Color>
    <Color x:Key="Primitive.Indigo.600">#4f46e5</Color>
    <!-- Custom indigo steps used for the hover/pressed states of the
         accent fill. Tailwind v3's indigo-700 is #4338ca and its
         indigo-800 #3730a3; neither of these is on the Tailwind ramp. -->
    <Color x:Key="Primitive.Indigo.700">#443cc7</Color>
    <Color x:Key="Primitive.Indigo.800">#3b34af</Color>

    <!-- Red ramp. Destructive actions and the close-window caption. -->
    <Color x:Key="Primitive.Red.500">#ef4444</Color>
    <!-- Custom reds used for the hover/pressed states of the title-bar
         X. Their 700 marks where they sit on this ramp: Tailwind v3's
         red-700 is #b91c1c, and neither of these is on that ramp. -->
    <Color x:Key="Primitive.Red.700.CaptionHover">#c0392b</Color>
    <Color x:Key="Primitive.Red.700.CaptionPressed">#a93226</Color>
    <Color x:Key="Primitive.Red.800">#991b1b</Color>
    <Color x:Key="Primitive.Red.900">#7f1d1d</Color>
    <!-- Custom step used for the pressed state of the danger fill. Sits
         below Red.900; not on the Tailwind ramp. -->
    <Color x:Key="Primitive.Red.900.Pressed">#6b1a1a</Color>

    <!-- Status colours. -->
    <Color x:Key="Primitive.Amber.400">#fbbf24</Color>
    <Color x:Key="Primitive.Amber.500">#f59e0b</Color>
    <Color x:Key="Primitive.Green.400">#4ade80</Color>

</ResourceDictionary>
