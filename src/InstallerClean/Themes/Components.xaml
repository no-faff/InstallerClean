<!--
    Component styles. Each Style here describes a control role
    (StandardPill, GhostPill, Card, etc) and consumes only semantic
    tokens from Tokens.xaml.

    Nothing in this file references a Primitive.* key. A component
    that needs a colour or numeric not yet in Tokens.xaml gets a new
    token there first, then consumes it from this file.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:loc="clr-namespace:InstallerClean.Resources"
                    xmlns:a11y="clr-namespace:InstallerClean.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Global defaults. Bundled-font assignment on Window and
         TextBlock removes the per-control FontFamily repetition. -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}"/>
    </Style>

    <!-- Selectable text. A read-only TextBox styled to look like a
         TextBlock but with user-selectable contents. Useful for
         showing values worth copying (file paths, version strings,
         hashes). -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}"/>
        <!-- IsTabStop=True so keyboard-only users can Tab onto a value
             and Ctrl+C it. Consumers that genuinely shouldn't be in
             the tab order set IsTabStop="False" at the site. -->
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="{loc:Translate Action.Copy}" Command="ApplicationCommands.Copy"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A value row in the detail panels' metadata grids (Orphaned and
         Registered): SelectableText's copyable, borderless look, in the
         heading colour at body size, and wrapping so a long value (a signing
         certificate, a long product field) breaks onto the next line rather
         than clipping. The wrap lives here, not on each of the value boxes, so
         a metadata row cannot be added without it. -->
    <Style x:Key="MetadataValueText" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Cards. Rounded surface containers. Card has standard inner
         padding; CardNoPad lets the consumer control its own padding
         (used for lists that paint their own row spacing). -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Card}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="{StaticResource Gap.Lg}"/>
    </Style>

    <Style x:Key="CardNoPad" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Card}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
    </Style>

    <!-- Focus visuals. Three sizes match the three pill heights
         (40 / 30 / 28). The default focus visual at the bottom of
         this file applies to anything else that takes focus
         (a Hyperlink or plain Button) so keyboard navigation
         stays visible everywhere. -->
    <Style x:Key="PillFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource Radius.PillFocus}"
                            BorderThickness="{StaticResource BorderThickness.Focus}"
                            BorderBrush="{DynamicResource Text.Body}"
                            Margin="-2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactPillFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource Radius.CompactPillFocus}"
                            BorderThickness="{StaticResource BorderThickness.Focus}"
                            BorderBrush="{DynamicResource Text.Body}"
                            Margin="-2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallPillFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource Radius.SmallPillFocus}"
                            BorderThickness="{StaticResource BorderThickness.Focus}"
                            BorderBrush="{DynamicResource Text.Body}"
                            Margin="-2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Focus ring for flat, rectangular controls: the read-only JSON
         preview TextBox in ConfirmSendResultLogWindow, the checkbox
         row further down (whose focusable extent is the box plus its
         label, a rectangle) and, through the app-default focus visual
         near the end of this file, in-body Hyperlinks and anything
         else with no override of its own. The pill visuals above sit
         around rounded controls and paint a 16 to 22 px rounded ring,
         which outside a sharp-cornered edge traces a shape the control
         does not have. This one uses a 2px corner radius so the ring
         tracks the underlying rectangle. -->
    <Style x:Key="FlatTextBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource Radius.Tight}"
                            BorderThickness="{StaticResource BorderThickness.Focus}"
                            BorderBrush="{DynamicResource Text.Body}"
                            Margin="-2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill buttons. Four flavours share one visual language (40px
         minimum height, fully rounded, a Type.Heading.Sm label at
         Medium weight):
           AccentPill   - the accent fill, for the one action a screen leads with.
           StandardPill - the quieter fill, for a filled action that must read
                          as secondary to a louder one beside it (the main
                          window's Move, against Delete). Its other use is the
                          way out of a window carrying bad news, where the
                          accent would read as encouragement.
           DangerPill   - the one action with no way back: deleting without a
                          Recycle Bin. Not for deleting to the bin, which the
                          app states plainly is safe and reversible; red on
                          that would argue against the app's own text and
                          spend the alarm on the routine path.
           GhostPill    - text-only action with no fill (Cancel / Details / About).

         A window whose only button is a way out takes the accent, the
         bad-news case above excepted: with nothing beside it to be quieter
         than, the standard fill reads as hesitant rather than secondary, and
         the accent-versus-standard distinction only ever has to work where
         both appear together, which is the main window's Delete and Move row
         alone.

         Which action a screen leads with is that screen's decision, taken
         where its Button names a style. A pill is a look, not a rank, so
         moving the emphasis between two buttons is a change at those two
         buttons and nowhere else.

         The pill heights here (and on the compact pills and PillTextBox
         below) are MinHeight, never Height: the label's font size tracks
         the OS text-scale factor, and a fixed height clips the label
         vertically once the scaled line height outgrows it. At 100% the
         minimum is exactly what renders. -->

    <Style x:Key="AccentPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading.Sm}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="28,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource Action.Accent.Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Accent.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StandardPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading.Sm}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="28,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource Action.Standard.Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Standard.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Standard.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading.Sm}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="28,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource Action.Danger.Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Danger.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Danger.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading.Sm}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Body}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact pill buttons (30 px minimum height). Compact variants
         for the About dialog's rows: CompactAccentPill mirrors
         AccentPill for the row's one leading action (the window's
         Close, its natural finishing act, the same reading that puts
         the accent on the completion overlay's Done), and
         CompactGhostPill mirrors GhostPill for the quiet asks beside
         it. -->

    <Style x:Key="CompactAccentPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompactPillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource Action.Accent.Background}"
                            CornerRadius="{StaticResource Radius.CompactPill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Accent.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 28px small ghost pill: wordless icon buttons sitting inside
         busy rows (the bottom-bar language globe, the completion card's
         donate heart) and the splash Cancel. BasedOn GhostPill so the
         look stays the ghost's; what changes is the tighter geometry
         and, with it, the ring: Radius.SmallPillFocus's derivation pins
         the 28px height to its 16 ring, so the height and the focus
         visual must move together, which is why this is a named style
         rather than per-site setters. -->
    <Style x:Key="SmallGhostPill" TargetType="Button" BasedOn="{StaticResource GhostPill}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SmallPillFocusVisual}"/>
    </Style>

    <Style x:Key="CompactGhostPill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompactPillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="{StaticResource Radius.CompactPill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Body}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs. -->

    <!-- Checkbox. Implicit rather than keyed, like ProgressBar and
         ScrollBar below: the app has one checkbox (the About window's
         auto-update switch), the control type has a single house look,
         and a second one should inherit it without opting in.

         The tick is a FILLED Path, not a stroked one. The theme's only
         stroke weights are Hairline (1) and the focus ring's 2, and a
         1px tick inside an 18px box reads as a scratch; a fill needs no
         new token to be legible.

         The row's whole extent takes the click (the transparent
         StackPanel background), so the label toggles the box, which is
         what a checkbox label is for. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FlatTextBoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18"
                                CornerRadius="{StaticResource Radius.Chip}"
                                Background="{StaticResource Action.Standard.Background}"
                                Margin="{StaticResource GapRight.Sm}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Fill="{StaticResource Text.Heading}"
                                  Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Action.Standard.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Action.Standard.Pressed}"/>
                        </Trigger>
                        <!-- Declared after the two above so a checked box keeps
                             the accent fill under the pointer rather than
                             reverting to the standard hover; the two
                             MultiTriggers then carry the accent's own hover and
                             pressed steps. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Action.Accent.Background}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Action.Accent.Hover}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Action.Accent.Pressed}"/>
                        </MultiTrigger>
                        <!-- Same disabled treatment as the pills: half opacity
                             on the whole control, box and label together. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface.Card}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text.Heading}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading.Sm}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <!-- WPF auto-generates the TextBox right-click ContextMenu in
             code at show-time. That code path bypasses the implicit-
             style scope in Application.Resources, so the themed
             ContextMenu / MenuItem styles defined elsewhere in this
             file never reach it. An explicit ContextMenu Setter is
             the only route for the dark theme to apply. -->
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="{loc:Translate Action.Cut}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                    <MenuItem Header="{loc:Translate Action.Copy}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                    <MenuItem Header="{loc:Translate Action.Paste}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                    <MenuItem Header="{loc:Translate Action.SelectAll}" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <Grid>
                            <!-- No Margin here. WPF's TextBoxView applies
                                 TextBox.Padding to the typed text itself (the
                                 stock TextBox template leaves PART_ContentHost
                                 marginless, yet Padding still insets the
                                 text), so binding Padding to this ScrollViewer's
                                 Margin too would apply it twice and push the
                                 typed text and caret a whole Padding.Left right
                                 of the placeholder. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                            <!-- Placeholder text comes from the box's Tag. Its
                                 Margin is the box Padding, the single inset
                                 TextBoxView gives the typed text, so the
                                 placeholder begins where the typed text and
                                 the caret do. A click falls through to it
                                 (IsHitTestVisible=False); shown only while the
                                 box is empty. -->
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="{DynamicResource Type.Body}" FontStyle="Italic"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List items. ListView and ListBox row styles. Selection
         highlight uses the standard action background rather than the
         indigo accent fill, so a selected row reads as "active
         selection" rather than "brand-flavoured". -->

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <!-- Stretch, not the Left default: GridViewRowPresenter arranges each
             cell's content at its own desired width and packs it to the left
             of the column unless the item's content is stretched to fill it,
             so a numeric cell's TextAlignment="Right" has no slack to act on
             without this. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="4,6">
                        <GridViewRowPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Sidebar}"/>
                        </Trigger>
                        <!-- Selection is declared AFTER hover, and the order is the
                             whole point: later setters win, so with hover last a
                             selected row swapped its selection fill for the hover
                             fill under the pointer and the selection read as having
                             vanished wherever the cursor went. The MultiTrigger then
                             gives selected-and-hovered the selection fill's own
                             hover step, the shape the CheckBox above uses for
                             checked-and-hovered, so the row still answers the
                             pointer without pretending to be unselected. The cells
                             that lift their foreground on selection key on
                             IsSelected alone and so hold through both. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Action.Standard.Background}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Action.Standard.Hover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="2,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Trigger order and the MultiTrigger are the ListViewItem
                             style's above, for the same reason and with the same
                             fills; the patch list is a ListBox and had the same
                             disappearing selection. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Sidebar}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Action.Standard.Background}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Action.Standard.Hover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Detail-window column headers. Made keyboard-focusable so column sort
         works without a mouse; WPF assumes a header is only ever clicked, and
         GridViewColumnHeader's static constructor sets Focusable false.
         Deriving from ButtonBase is NOT enough to get the activation with it.
         Its OnClick raises the Click event only for an access-key or automation
         invoke, or while the mouse pointer is inside the header's own bounds
         (dotnet/wpf, GridViewColumnHeader.cs: OnClick guards on
         `IsAccessKeyOrAutomation || !IsMouseOutside()`), so ButtonBase's Space
         and Enter handling does run and then has its Click dropped whenever the
         pointer is anywhere else on screen. Each detail window therefore wires
         Space and Enter itself, in ColumnHeader_PreviewKeyDown; preview,
         because ButtonBase marks both keys handled at the header before a
         bubbling handler further up could see them. The Role=Padding trigger
         keeps the filler header WPF generates past the last column out of the
         tab order, where it would otherwise be a focusable stop with no column
         behind it. The IsKeyboardFocused fill gives the focused header a visible cue on the
         dark surface; the sort direction itself reaches a screen reader as the
         sorted header's AutomationProperties.Name (set in UpdateSortIndicators),
         which also keeps the ▲/▼ glyph appended to the visible header text out
         of speech. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <!-- Left-align the header content so each heading sits above its
             left-aligned column text. GridViewColumnHeader's metadata defaults
             HorizontalContentAlignment to Center, which reads as a heading
             floating off-centre from the values under it. The numeric columns
             opt into NumericColumnHeader below to sit over their right-aligned
             figures instead. -->
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="HeaderBorder" Background="Transparent" Padding="8,6"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Surface.Sidebar}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Action.Standard.Background}"/>
                            <!-- Text.Muted on Action.Standard.Background is 4.04:1 (fails AA
                                 4.5:1 for the 12px header text); the focus fill must lift the
                                 header foreground too, as the highlighted menu row lifts its
                                 gesture column. Text.Body on that fill is 6.97:1. -->
                            <Setter Property="Foreground" Value="{StaticResource Text.Body}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="Padding">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Header style for the detail-window numeric columns (Size, Patches),
         whose cells right-align their figures. Right-aligning the header sits
         the heading directly over the digits rather than to their left. Based
         on the header style above so the focus, keyboard-sort and
         sort-indicator behaviour carry over unchanged; only the content
         alignment differs. -->
    <Style x:Key="NumericColumnHeader" TargetType="GridViewColumnHeader"
           BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- Body scroll regions. A bare ScrollViewer is focusable and a tab
         stop by default, so every scrollable text block was an
         anonymous, unnamed pane stop in the tab order even when there
         was nothing to scroll. The trigger keeps it out of the tab
         order until its content actually overflows; once it can
         scroll, it takes focus (arrow and page keys are the only
         keyboard route for text-only content) and announces by the
         AutomationProperties.Name each consuming site sets. -->
    <Style x:Key="BodyScrollRegion" TargetType="ScrollViewer">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ScrollableHeight, RelativeSource={RelativeSource Self}}" Value="0"/>
                    <Condition Binding="{Binding ScrollableWidth, RelativeSource={RelativeSource Self}}" Value="0"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Links. SubtleLink is the app's only link style, on every link in
         every window: an in-body Hyperlink, underlined at rest so it reads as
         a link without leaning on its hue, and brightening on hover and
         keyboard focus. -->

    <Style x:Key="SubtleLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource Link.Rest}"/>
        <!-- Underlined at rest, not only on hover/focus. An in-sentence link
             set apart by its hue alone fails WCAG 1.4.1: the rest hue is
             1.16:1 and 2.01:1 against the two surrounding text tiers, both
             under the 3:1 the guideline asks of a non-text distinction, and a
             reader with reduced colour vision cannot tell it is a link. The
             underline is the always-on, colour-independent cue and the
             brighten below sits on top of it, never in place of it. -->
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Link.Hover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Link.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Scrollbar. Thin (8px), rounded, subtle thumb that brightens
         on hover. One keyed Thumb style plus a Style.Triggers branch
         covers both horizontal and vertical orientations. -->

    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bg" Background="{StaticResource Scrollbar.Thumb}"
                            CornerRadius="{StaticResource Radius.Chip}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Scrollbar.Thumb.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Scrollbar.Thumb.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible but hit-testable page-track buttons. Without an
         Increase/Decrease repeat-button on the Track, clicking the groove
         above or below the thumb does nothing; a Transparent background
         (not null) is what makes the groove clickable to page up / down. -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <!-- Padding reaches the template Border and insets the Track, and
             with it the ends of the thumb's travel. Zero here; CardScrollBar
             below sets it for bars that run flush along a rounded card edge. -->
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent"
                            CornerRadius="{StaticResource Radius.Chip}"
                            Padding="{TemplateBinding Padding}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    Padding="{TemplateBinding Padding}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A scrollbar running flush along the edge of a Radius.Pill card
         (the Details list panes). The card paints only inside its corner
         curve while ClipToBounds clips at the rectangular layout bounds,
         so a thumb allowed to the end of an un-inset track sits in the
         corner zone: inside the rectangle, outside the pane, drawn on the
         window background. The end padding equals the corner radius
         (Padding.ScrollBarCardEnds, tied to Radius.Pill in Tokens.xaml)
         so travel stays on the straight run of the edge. A list's
         template-internal bars pick this up through a style scoped in the
         list's own Resources: ScrollBar derives from Control, and a
         tree-scoped implicit style reaches Control-derived elements
         inside templates. -->
    <Style x:Key="CardScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Padding" Value="{StaticResource Padding.ScrollBarCardEnds}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Padding" Value="{StaticResource Padding.ScrollBarCardEndsHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Caption buttons. Title-bar minimise / maximise / close. The
         CaptionClose style is distinct because the close button uses
         Action.CaptionClose.* on hover (red, matching the Windows
         convention) where the others use the Action.Standard
         background. -->

    <!-- The chrome glyphs (E921 minimise, E922 maximise, E923 restore,
         E8BB close) live in Segoe MDL2 Assets, the canonical Windows
         chrome font that ships with every Windows 10+ install. The
         template paints them with an explicit TextBlock rather than
         a ContentPresenter because the application-wide implicit
         <Style TargetType="TextBlock"> further up this file sets
         FontFamily to the bundled body font: ContentPresenter wraps
         a string Content in a TextBlock at runtime, that TextBlock
         picks up the implicit style, and a FontFamily setter on the
         enclosing Button never reaches it. An explicit TextBlock
         with a direct FontFamily setter wins because direct local
         values beat implicit-style values. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <!-- Caption buttons match Windows native chrome and stay out
             of the keyboard focus path: Focusable=False avoids a click
             leaving the indigo accent on the button after minimise +
             Alt+Tab restore (the click would otherwise transfer focus
             to the button and the next paint would see IsKeyboardFocused
             still true). FocusVisualStyle is null because no focus path
             ever reaches them. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Standard.Background}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.CaptionButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.CaptionClose.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.CaptionClose.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips. AccentTooltip is the indigo accent tooltip for
         the donate / star buttons that shouts a little; the implicit
         ToolTip style below is the default for everything else. -->

    <Style x:Key="AccentTooltip" TargetType="ToolTip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Wrap width scales with the OS text size; a fixed cap
             squeezes scaled text into an ever taller, thinner column. -->
        <Setter Property="MaxWidth" Value="{a11y:TextScaled 280}"/>
        <Setter Property="Placement" Value="Top"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- The hairline exists so the tooltip keeps an edge when
                         it is drawn over an accent pill: fill on fill, the two
                         indigos are the same colour and the tooltip reads as
                         part of the button under it rather than as something
                         on top. The completion heart's is the one that
                         reliably crosses one: it opens flush above the heart,
                         across the Done button.

                         One brush has to serve three consumers on two
                         surfaces, and only the completion heart's tooltip
                         opens over a card; the About window's star and cuppa
                         pills sit straight on the lighter window background.
                         So the constraint is a single brush dark enough to
                         read against the accent fill and quiet enough on
                         every dark surface a tooltip can open over. The card
                         colour meets both: invisible on the card, a faint
                         darker edge on About. Anything lighter would be a
                         frame there instead of an edge.

                         Thickness resource, not the Double one: a
                         {StaticResource} lookup runs no TypeConverter, so a
                         Double will not satisfy BorderThickness. -->
                    <Border Background="{StaticResource Action.Accent.Background}"
                            BorderBrush="{StaticResource Surface.Card}"
                            BorderThickness="{StaticResource BorderThickness.Hairline}"
                            CornerRadius="{StaticResource Radius.Chip}"
                            Padding="10,6">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{StaticResource Text.Heading}"
                                   FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default ToolTip for attribute-syntax ToolTip="..." usages. Dark
         card surface, hairline border, body text. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <!-- Wrap width scales with the OS text size, as on AccentTooltip. -->
        <Setter Property="MaxWidth" Value="{a11y:TextScaled 320}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Surface.Sidebar}"
                            BorderBrush="{StaticResource Action.Standard.Background}"
                            BorderThickness="{StaticResource BorderThickness.Hairline}"
                            CornerRadius="{StaticResource Radius.Chip}"
                            Padding="10,6">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{StaticResource Text.Body}"
                                   FontSize="{DynamicResource Type.Body}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default focus visual. Catches anything that takes focus but
         has no FocusVisualStyle override (plain Buttons, Hyperlinks).
         Pill buttons opt out via their own *FocusVisual styles above.
         BasedOn the flat ring rather than carrying a template of its
         own so the catch-all cannot drift from the app's one focus
         weight (BorderThickness.Focus): a ring drawn thinner here
         would make links look less focused than every other
         control. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"
           BasedOn="{StaticResource FlatTextBoxFocusVisual}"/>

    <!-- Progress bar. Slim dark bar. Determinate uses PART_Indicator
         (WPF stock). Indeterminate has two presentations: a sweeping
         bar when animations are on, and a static full-width fill when
         the Windows "show animations" setting is off (reduced motion). The sweep
         moves the RepeatBehavior onto the DoubleAnimation rather than
         the wrapping Storyboard so the compiled BAML carries no literal
         "Storyboard RepeatBehavior=Forever" attribute pair.

         The sweep translates the 80 px bar from X=-80 to X=320 (max bar
         width 240 px). DoubleAnimation can't template-bind ActualWidth,
         so a wider indeterminate consumer needs the To value raised. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Surface.Sidebar}"/>
        <Setter Property="Foreground" Value="{StaticResource Action.Accent.Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="{StaticResource Radius.Chip}"
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                            <Border x:Name="IndeterminateBar"
                                    Width="80"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTransform"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- Reduced-motion stand-in for the sweep: a static,
                                 full-width fill shown instead of IndeterminateBar
                                 when "show animations" is off, so an indeterminate
                                 bar still reads as busy without moving. -->
                            <Border x:Name="StaticBusyBar"
                                    CornerRadius="{StaticResource Radius.Chip}"
                                    Background="{TemplateBinding Foreground}"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Indeterminate with animations on: the bar sweeps. The
                             storyboard is named so the companion ExitActions stop
                             it the moment the bar stops being indeterminate or
                             "show animations" is switched off mid-run, rather than
                             leaving a clock running on a hidden element (and
                             stacking a second clock if it later re-enters). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static a11y:AccessibilitySettings.Current}, Path=ReduceMotion}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible"/>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateMarquee">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80" To="320"
                                                         Duration="0:0:1.4"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateMarquee"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Indeterminate with animations off: a static full-width
                             fill stands in for the sweep, so an animation-off user
                             sees no movement while the bar still reads as busy. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static a11y:AccessibilitySettings.Current}, Path=ReduceMotion}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StaticBusyBar" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu and menu item. Padding/CornerRadius literals
         here are per-control tunings, not spacing-token decisions:
         the Spacing scale is uniform and does not capture the
         asymmetric (12,6) padding menu rows want. -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Surface.Sidebar}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Action.Standard.Background}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Hairline}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Chip}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Body}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Tight}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="GestureText"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="20,0,0,0"
                                       Foreground="{StaticResource Text.Dim}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Action.Standard.Background}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Heading}"/>
                            <!-- Text.Dim on Action.Standard.Background is 3.34:1 (fails AA
                                 4.5:1 for normal text); the highlighted row must lift the
                                 gesture column too, not just the header. -->
                            <Setter TargetName="GestureText" Property="Foreground" Value="{StaticResource Text.Body}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Dim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
