<!--
    Semantic design tokens. Each entry is a role in the UI vocabulary.

    Colour roles resolve to a Color in Primitives.xaml. Numeric roles
    (typography, radius, border, spacing) carry a literal value plus a
    comment naming the corresponding step in the primitive scale so
    the canonical scale stays legible.

    Window XAML and component styles consume tokens from this file,
    never primitives. A colour or scale change edits the token here,
    not the consumer. A new role with no existing token gets a new
    token rather than a direct primitive reach.

    Naming: <category>.<role>[.<state>].
        Surface.*, Text.*, Action.<intent>.<state>, Status.*,
        Decoration.*, Link.*, Scrollbar.*, Border.*, Progress.*,
        Type.*, Radius.*, BorderThickness.*, Margin.*,
        Padding.*, Gap.*, GapBottom.*, GapTop.*, GapRight.*,
        GapLeft.*, GapX.*.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Surfaces. Surface.Sidebar is the base window background and
         Surface.Card the raised card surface; Surface.Overlay is the
         modal dim tint. -->
    <SolidColorBrush x:Key="Surface.Sidebar"       Color="{StaticResource Primitive.Slate.800}"/>
    <SolidColorBrush x:Key="Surface.Card"          Color="{StaticResource Primitive.Slate.900}"/>
    <SolidColorBrush x:Key="Surface.Overlay"       Color="{StaticResource Primitive.Slate.950.Alpha50}"/>

    <!-- Text tiers. Heading > Body > Muted > Dim. The lowest tier
         that still reads at the rendered size wins. -->
    <SolidColorBrush x:Key="Text.Heading" Color="{StaticResource Primitive.Slate.50}"/>
    <SolidColorBrush x:Key="Text.Body"    Color="{StaticResource Primitive.Slate.300}"/>
    <SolidColorBrush x:Key="Text.Muted"   Color="{StaticResource Primitive.Slate.400}"/>
    <SolidColorBrush x:Key="Text.Dim"     Color="{StaticResource Primitive.Slate.500}"/>

    <!-- Actions. Each action role has Default / Hover / Pressed
         states. Buttons consume these via component styles in
         Components.xaml; raw window XAML reaches for them only for
         one-offs (e.g. a selected list row fills with
         Action.Standard.Background). -->

    <!-- Standard: the default button fill (slate). -->
    <SolidColorBrush x:Key="Action.Standard.Background" Color="{StaticResource Primitive.Slate.700}"/>
    <SolidColorBrush x:Key="Action.Standard.Hover"      Color="{StaticResource Primitive.Slate.700.Hover}"/>
    <SolidColorBrush x:Key="Action.Standard.Pressed"    Color="{StaticResource Primitive.Slate.700.Pressed}"/>

    <!-- Accent: the emphasis fill (indigo), for whichever action a screen
         leads with. Which action that is belongs to the screen, not to the
         token: the Button picks Accent or Standard at its own site. -->
    <SolidColorBrush x:Key="Action.Accent.Background" Color="{StaticResource Primitive.Indigo.600}"/>
    <SolidColorBrush x:Key="Action.Accent.Hover"      Color="{StaticResource Primitive.Indigo.700}"/>
    <SolidColorBrush x:Key="Action.Accent.Pressed"    Color="{StaticResource Primitive.Indigo.800}"/>

    <!-- Danger: destructive (red). -->
    <SolidColorBrush x:Key="Action.Danger.Background" Color="{StaticResource Primitive.Red.800}"/>
    <SolidColorBrush x:Key="Action.Danger.Hover"      Color="{StaticResource Primitive.Red.900}"/>
    <SolidColorBrush x:Key="Action.Danger.Pressed"    Color="{StaticResource Primitive.Red.900.Pressed}"/>

    <!-- Caption-button: the title-bar minimise and maximise fill. Only
         the pressed state needs a step of its own; the hover state takes
         Action.Standard.Background, so there is no matching
         Action.CaptionButton.Hover to reach for. -->
    <SolidColorBrush x:Key="Action.CaptionButton.Pressed" Color="{StaticResource Primitive.Slate.600}"/>

    <!-- Caption-close: distinct red used only on the title-bar X button.
         Different shade from Action.Danger so the chrome reads
         consistently with Windows close-button conventions. -->
    <SolidColorBrush x:Key="Action.CaptionClose.Hover"   Color="{StaticResource Primitive.Red.700.CaptionHover}"/>
    <SolidColorBrush x:Key="Action.CaptionClose.Pressed" Color="{StaticResource Primitive.Red.700.CaptionPressed}"/>

    <!-- Status. Outcome and state colours. Warning is imminent risk
         requiring user attention; Success is completion or positive
         outcome. -->
    <SolidColorBrush x:Key="Status.Warning" Color="{StaticResource Primitive.Amber.500}"/>
    <SolidColorBrush x:Key="Status.Success" Color="{StaticResource Primitive.Green.400}"/>

    <!-- Decoration. Brand-flavour icons. Distinct from Status colours
         so the two coexist on screen without semantic collision. Heart
         (Red.500 #ef4444) is 3.89:1 against Surface.Sidebar #1e293b,
         narrowly above the WCAG 1.4.11 non-text 3:1 threshold; the icon
         is decorative (AutomationProperties.Name carries the meaning)
         so the margin is acceptable. Brighten to Red.400 if a user
         reports trouble seeing the heart against the sidebar. -->
    <SolidColorBrush x:Key="Decoration.Heart" Color="{StaticResource Primitive.Red.500}"/>
    <SolidColorBrush x:Key="Decoration.Star"  Color="{StaticResource Primitive.Amber.400}"/>

    <!-- Links. SubtleLink is the app's only link, so these are its two
         states rather than two kinds of link. Rest is Indigo.400 at full
         opacity, measured on Surface.Sidebar (the AboutWindow licence
         link's home, and the lightest surface a link sits on): a 66%
         alpha wash of it there measures 2.95:1, under the WCAG AA-text
         4.5:1 line, where full opacity sits at 4.90:1. Dimming rest for
         subtlety therefore fails AA and must not come back. Hover
         brightens to Indigo.300, 7.34:1 on the same surface, and serves
         keyboard focus as well as the pointer. -->
    <SolidColorBrush x:Key="Link.Rest"  Color="{StaticResource Primitive.Indigo.400}"/>
    <SolidColorBrush x:Key="Link.Hover" Color="{StaticResource Primitive.Indigo.300}"/>

    <!-- Scrollbar. The thumb is the one control a user has to FIND before
         they can use it, so the resting state is the one that has to be
         visible, and it was the faintest thing in the theme: white at 20%
         composites to 1.84:1 on Surface.Card and 1.88:1 on
         Surface.Sidebar, against the 3:1 WCAG 1.4.11 asks of the visual
         information that identifies a control. The user-agent exemption
         does not cover it, the ScrollBar template being the app's own
         (Components.xaml). At 38% it is 3.41:1 on the card and 3.27:1 on
         the sidebar and still reads as a quiet thumb rather than a solid
         bar. Hover and drag share the 50% step, 5.08:1 on the card, so
         there is still a plain brightening between the two states. -->
    <SolidColorBrush x:Key="Scrollbar.Thumb"        Color="{StaticResource Primitive.Slate.50.Alpha38}"/>
    <SolidColorBrush x:Key="Scrollbar.Thumb.Hover"  Color="{StaticResource Primitive.Slate.50.Alpha50}"/>

    <!-- Border. The edge that gives a control a visible extent: the About
         window's checkbox, a selected row in either details list, and the
         backup-folder box. No FILL can do that job here. The five opaque
         structural surfaces span 2.36:1 between the widest pair and under
         1.75:1 between every adjacent one, so a control painted out of that
         set cannot reach the 3:1 WCAG 1.4.11 asks of the visual information
         identifying a control, and the next step up the ramp is a body-text
         brightness. A line can, being drawn against a surface rather than
         being one: 4.72:1 on Surface.Sidebar, 5.76:1 on Surface.Card, and
         3.34:1 against Action.Standard.Background, which is the quietest
         pairing there is (a selected row's own fill, on the side away from
         the window).

         Slate.500 is also what Text.Dim resolves to, and consuming that here
         instead would be a text tier doing an edge's job: the layering rule
         is that a new role gets a new token, so a later change to either
         moves one and not the other.

         NOT the app's every hairline. The tooltip and context-menu edges keep
         their own quieter brushes, argued at those templates: they separate a
         popup from what it is drawn over, where this one has to be findable. -->
    <SolidColorBrush x:Key="Border.Control" Color="{StaticResource Primitive.Slate.500}"/>

    <!-- Progress. Its own role rather than the accent fill it used to share,
         because a progress bar is measured against its own track and the
         accent is 2.33:1 there. Indigo.400 is 4.90:1 on the Surface.Sidebar
         track the three bars sit in and 5.98:1 on the card behind the
         operating overlay's. Neither is dimmed by the overlay: that card is
         opaque over the dim and the track is opaque over the card.

         So the bar no longer matches the accent buttons, and that was seen
         side by side at true size and accepted rather than overlooked. Same
         colour as Link.Rest, separate token for the reason above. -->
    <SolidColorBrush x:Key="Progress.Fill" Color="{StaticResource Primitive.Indigo.400}"/>

    <!-- Typography. Six scaled steps, Display down to Caption, which are
         exactly the set App scales with the OS text-size slider, plus the
         fixed Type.TitleBar sitting outside that set (the reason is at
         the token). Each role is named for the job it does, not the size,
         so a size change edits the token instead of renaming
         consumers. -->
    <!-- The name after Poppins is a fallback, and it is here for one character.
         French sets a narrow no-break space (U+202F) before its high punctuation
         and inside guillemets, and Poppins carries no glyph for it. Without a
         name to fall back to, that character is left to the font mapping
         Windows keeps for the purpose, which sends it to a Mongolian face: the
         same code point is that script's vowel separator. Segoe UI has the
         glyph and is the Windows interface face, so naming it keeps the
         character on a font chosen here rather than on one chosen for another
         script.

         A family that cannot render a character maps none of it and the next
         name in the list is tried, so this adds a step and takes nothing away.
         The scripts Poppins does not cover and Segoe UI does not either,
         Japanese, Korean and Chinese, fall through to the system's own fonts as
         before. The Cyrillic and Vietnamese letters Poppins has no glyph for
         are in Segoe UI, so those have a named font here as well. -->
    <FontFamily x:Key="Type.FontFamily">pack://application:,,,/Fonts/#Poppins, Segoe UI</FontFamily>

    <sys:Double x:Key="Type.Display">29</sys:Double>     <!-- splash hero -->
    <sys:Double x:Key="Type.Heading.Lg">23</sys:Double>  <!-- completion heading -->
    <sys:Double x:Key="Type.Heading.Md">21</sys:Double>  <!-- about title -->
    <sys:Double x:Key="Type.Heading.Sm">15</sys:Double>  <!-- status, section labels, pills -->
    <!-- Window title-bar text. A fixed size, deliberately NOT in App's
         text-scaled set, because the caption bar is a fixed 32px
         (WindowChrome.CaptionHeight): a title that grew with the OS text-size
         slider would outgrow and clip the bar at large scales (observed at
         225%). The caption buttons are fixed for the same reason. Consumed via
         StaticResource since it never changes. -->
    <sys:Double x:Key="Type.TitleBar">15</sys:Double>    <!-- window title bar (fixed) -->
    <sys:Double x:Key="Type.Body">13</sys:Double>        <!-- body copy, descriptions -->
    <sys:Double x:Key="Type.Caption">12</sys:Double>     <!-- metadata labels, footer -->

    <!-- Radius. Seven roles cover the app:
           Pill         - fully rounded 40 px action buttons. The Card
                          styles take it too, so a pill and a card round
                          alike; it is not only the button radius.
           CompactPill  - fully rounded 30 px compact buttons.
           ModalCard    - the modal dialog cards.
           CardSm       - smaller rounded surfaces (splash card border).
           Inset        - card-within-a-card surfaces (JSON preview, etc.).
           Chip         - the small rounded furniture: both tooltips, the
                          context menu, the scrollbar thumb and track, the
                          progress bar.
           Tight        - the menu-item highlight, and the focus ring on
                          flat rectangular controls. -->
    <CornerRadius x:Key="Radius.Pill">20</CornerRadius>
    <CornerRadius x:Key="Radius.CompactPill">15</CornerRadius>
    <CornerRadius x:Key="Radius.ModalCard">16</CornerRadius>
    <CornerRadius x:Key="Radius.CardSm">12</CornerRadius>
    <CornerRadius x:Key="Radius.Inset">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">4</CornerRadius>
    <CornerRadius x:Key="Radius.Tight">2</CornerRadius>

    <!-- Focus-visual radii. Derived geometry, not part of the radius
         ramp above. Each ring is fully rounded, so its radius is half
         its own height, and the -2 margin every focus visual carries
         makes that height the pill's plus 4: a 40px pill needs 22, a
         30px compact pill 17, a 28px small pill 16. Defined here, next
         to each other, so a change to a pill's height or radius moves
         its ring with it. -->
    <CornerRadius x:Key="Radius.PillFocus">22</CornerRadius>
    <CornerRadius x:Key="Radius.CompactPillFocus">17</CornerRadius>
    <CornerRadius x:Key="Radius.SmallPillFocus">16</CornerRadius>

    <!-- Scrollbar end-insets for a bar living flush against the edge of a
         Radius.Pill card (the Details list panes). Derived geometry like
         the focus radii above: each end inset equals Radius.Pill, so the
         thumb's travel ends where the corner curve begins and the thumb
         stays on the straight run of the edge. Without the inset the
         thumb at either end of travel sits in the corner zone: a rounded
         Border paints only inside its curve while ClipToBounds clips at
         the rectangular layout bounds, so the thumb lands inside the
         rectangle but outside the pane, drawn on the window background.
         Thickness twins of a CornerRadius value because a resource
         lookup runs no TypeConverter (the line-thickness note below);
         ScrollBarCardInsetTests holds both equal to Radius.Pill. -->
    <Thickness x:Key="Padding.ScrollBarCardEnds">0,20,0,20</Thickness>
    <Thickness x:Key="Padding.ScrollBarCardEndsHorizontal">20,0,20,0</Thickness>

    <!-- Line thickness. BorderThickness.* satisfies the properties taking
         a Thickness struct (Border.BorderThickness,
         Control.BorderThickness). The scalar Shape.StrokeThickness
         cannot share these, and the split is not stylistic: XAML
         resource lookups don't run the ThicknessConverter, so a
         Thickness resource cannot satisfy a Double property; the
         mismatched key raises a XamlParseException the first time the
         consuming template is realised at runtime. A Shape consumer
         therefore needs a parallel sys:Double StrokeThickness.<role>
         token; none exists while nothing consumes one. -->
    <Thickness x:Key="BorderThickness.Hairline">1</Thickness>
    <!-- The focus ring's weight, and the only thing drawn at 2: a border
         a reader means to be ordinary is Hairline. -->
    <Thickness x:Key="BorderThickness.Focus">2</Thickness>

    <!-- Spacing. Thicknesses cover Margin/Padding sites. Directional
         (GapBottom, GapTop, GapRight, GapLeft) for one-sided patterns;
         GapX for symmetric horizontal (both sides equal);
         multi-sided literal Margins stay for genuine one-offs. A
         scalar Spacing.* ramp earns a place only when a real Width /
         Height / scalar-Padding consumer surfaces. -->

    <Thickness x:Key="Gap.Lg">16</Thickness>

    <Thickness x:Key="GapBottom.Sm">0,0,0,8</Thickness>
    <Thickness x:Key="GapBottom.Md">0,0,0,12</Thickness>
    <Thickness x:Key="GapBottom.Lg">0,0,0,16</Thickness>
    <Thickness x:Key="GapBottom.Xl">0,0,0,24</Thickness>

    <Thickness x:Key="GapTop.Sm">0,8,0,0</Thickness>

    <Thickness x:Key="GapRight.Sm">0,0,8,0</Thickness>
    <!-- Icon-after-text spacing: 6 sits below the 8/12/16/24 scale on
         purpose. A 12 to 18 px icon next to body text reads tightly at
         6 and slightly loose at 8; the irregular value names the
         pattern rather than hiding it as a literal in four window
         XAMLs. -->
    <Thickness x:Key="GapRight.Icon">0,0,6,0</Thickness>

    <Thickness x:Key="GapLeft.Md">12,0,0,0</Thickness>

    <!-- Horizontal-only gap (both sides). Used where an inline
         element wants equal left+right margin without affecting
         vertical layout. -->
    <Thickness x:Key="GapX.Md">12,0,12,0</Thickness>

    <!-- Outer margin shared by the detail windows (Orphaned, Registered,
         About) so they share a consistent inset. -->
    <Thickness x:Key="Margin.DetailWindow">24,4,24,24</Thickness>

    <!-- Padding shared by the modal-card Borders. Each of them also
         shares Surface.Card, Radius.ModalCard and the
         Action.Standard.Background outline; the 32,28 pair completes the
         card shape. -->
    <Thickness x:Key="Padding.ModalCard">32,28</Thickness>

    <!-- Inset of the main-window scan-result panel. The window is
         SizeToContent="Height", so the panel sits in its own Auto row
         above the bottom-nav row: top clears the 32px title bar, bottom
         is the gap to the nav (which carries its own 8px top margin). -->
    <Thickness x:Key="Margin.MainContent">24,16,24,16</Thickness>

    <!-- Negative top/right margin used by the detail-window caption-X
         close buttons (About, Registered, Orphaned). The -24 right
         component pulls the X out past Margin.DetailWindow's 24 right
         component so the X sits at the window edge; the two move
         together. -->
    <Thickness x:Key="Margin.CloseButtonOverhang">0,-4,-24,0</Thickness>

</ResourceDictionary>
