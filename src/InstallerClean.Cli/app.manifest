<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Nothing at runtime reads this version: elevation is decided by trustInfo
       below, no dependentAssembly entry binds against the identity, and every
       version the tool reports comes from Assembly.GetName().Version. It cannot
       be dropped, though, because the loader validates the element at process
       start, so it has to carry some value.

       That value tracks Directory.Build.props, stamped by bump-version.sh and
       enforced by scripts/check-version-surfaces.mjs. The manifest is embedded
       in the exe, where sigcheck -m and any resource viewer show it; this
       comment is not. Untying it from the release version leaves the shipped
       binary asserting a version it is not, to the people most likely to look. -->
  <assemblyIdentity version="3.0.0.0" name="InstallerClean.cli"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
      <!-- requireAdministrator IS LOAD-BEARING FOR A SAFETY CONDITION AND NOT ONLY
           FOR WRITE ACCESS, which is the half nobody would guess from here. The scan
           asks Windows Installer whether a product a patch file declares is installed,
           and treats ERROR_UNKNOWN_PRODUCT as a positive answer of "this machine does
           not hold it", which is correct and is what stops an irrelevant declared target
           withholding the whole class. A caller that cannot see a per-user product
           belonging to another account is told exactly that about a product that IS
           there. The query is made with the Everyone SID across all contexts, and an
           administrator may query product and patch data for any instance and any user
           on the computer; a non-administrator may not.

           So dropping this to asInvoker would not merely fail a write later on. It would
           turn a positive answer into a false one inside the condition that decides
           whether a cached patch is still needed, with a green build and no test going
           red. The other end of this is commented at
           InstallerQueryService.ResolveProductInstances. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Microsoft never published a separate
           compatibility GUID for Windows 11; apps target the Windows 10
           GUID and Windows reports them as compatible with Windows 11
           automatically. The 8e0f7a12 GUID covers both. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- longPathAware so File.Move / Path.GetFullPath honour paths
           past MAX_PATH (260 chars). -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
