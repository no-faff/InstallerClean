<Project Sdk="Microsoft.NET.Sdk">

  <!--
    InstallerClean.Cli: console host for the headless service surface
    in InstallerClean.Core. A real .NET console exe (subsystem CONSOLE)
    so PowerShell, cmd and scheduled tasks block on the process
    naturally.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- R2R off, matching InstallerClean.csproj. Same AV-signal-
         stability rationale documented there. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <RootNamespace>InstallerClean.Cli</RootNamespace>
    <AssemblyName>installerclean-cli</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shares the GUI's app.ico; the two exes ship in the same install directory. -->
    <ApplicationIcon>..\InstallerClean\Assets\app.ico</ApplicationIcon>
    <!-- Comments, and deliberately the same sentence as the GUI: it says what
         the tool does, which is the same job by another face. Naming the face
         here too would repeat the "(command line)" that File description
         carries one line above it in the same panel. See the GUI csproj. -->
    <Description>Finds the MSI and MSP files in C:\Windows\Installer that no installed program still needs, and moves or deletes them.</Description>
    <!-- See the GUI csproj for why this is set: unset, Windows shows the
         assembly name as the File description, which repeats the filename. -->
    <AssemblyTitle>Cleans up unneeded files in C:\Windows\Installer (command line)</AssemblyTitle>
    <Authors>No Faff</Authors>
    <RepositoryUrl>https://github.com/no-faff/InstallerClean</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstallerClean.Core\InstallerClean.Core.csproj" />
  </ItemGroup>

</Project>
