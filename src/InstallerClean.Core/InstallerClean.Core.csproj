<Project Sdk="Microsoft.NET.Sdk">

  <!--
    InstallerClean.Core: headless library shared by the WPF app
    (InstallerClean) and the console CLI (InstallerClean.Cli).

    References no WPF assembly: everything in here runs without a WPF
    dispatcher, without HWND ownership, and without the
    PresentationFramework / PresentationCore assemblies. Win32 P/Invoke
    is fine (msi.dll, kernel32, shell32) because those work in any
    process subsystem.

    MessageBox, Window, WindowChrome and XAML-bound view-models live
    in InstallerClean (the WPF project), not here.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstallerClean</RootNamespace>
    <AssemblyName>InstallerClean.Core</AssemblyName>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- AllowUnsafeBlocks lets the LibraryImport source generator emit
         the pointer-handling stubs it needs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Never packed, so this feeds no .nupkg. It is here so the licence
         reads the same in all three project files: the Apache 2.0 switch
         missed CONTRIBUTING.md precisely because the licence was stated in
         some places and merely absent in others, which a sweep reads as
         nothing to change. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.3.0" />
    <!-- Abstractions only: callers register Core's services into their
         own IServiceCollection. The Core library itself doesn't pick
         a container implementation. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <!-- Span, Memory and ReadOnlySpan, which .NET Framework 4.8 does not
         carry. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <!-- The JSON reader and writer for the report, the settings and
         update.json. -->
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
    <!-- TimeProvider, which .NET Framework 4.8 does not carry. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.7" />
    <!-- System.HashCode, for HashCode.Combine. -->
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpClient and the types around it are in this framework assembly,
         which a .NET Framework project references, and ImplicitUsings
         imports, only when asked. -->
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- Localisation: the typed Strings accessor is hand-managed via
       scripts/regenerate-strings-designer.sh; Strings.resx is the
       neutral resx for the assembly's NeutralLanguage (en-GB). A satellite
       resx sits beside it for every other language in
       SupportedLanguages.CultureNames (Strings.<culture>.resx), so the
       build emits a satellite assembly per culture and .NET resource
       fallback serves the neutral resx only for a culture with no
       satellite. Each satellite is generated from its
       gen-strings-<code>.mjs MAP; only the resx is committed. A new UI
       language lands as a new Strings.<culture>.resx generated the same
       way (Arabic is README-only and has no resx). -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <ManifestResourceName>InstallerClean.Resources.Strings</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
