<Project Sdk="Microsoft.NET.Sdk">

  <!--
    InstallerClean.Core: headless library shared by the WPF app
    (InstallerClean) and the console CLI (InstallerClean.Cli).

    Targets net10.0 (not net10.0-windows): everything in here runs
    without a WPF dispatcher, without HWND ownership, and without the
    PresentationFramework / PresentationCore assemblies. Win32 P/Invoke
    is fine (msi.dll, kernel32, shell32) because those work in any
    process subsystem.

    MessageBox, Window, WindowChrome and XAML-bound view-models live
    in InstallerClean (the WPF project), not here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstallerClean</RootNamespace>
    <AssemblyName>InstallerClean.Core</AssemblyName>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- AllowUnsafeBlocks lets the LibraryImport source generator emit
         the pointer-handling stubs it needs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Never packed, so this feeds no .nupkg. It is here so the licence
         reads the same in all three project files: the Apache 2.0 switch
         missed CONTRIBUTING.md precisely because the licence was stated in
         some places and merely absent in others, which a sweep reads as
         nothing to change. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
    <!-- Abstractions only: callers register Core's services into their
         own IServiceCollection. The Core library itself doesn't pick
         a container implementation. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <!-- EventLog is only available on Windows but the source builds
         for any platform. The platform analyser is satisfied by the
         assembly-wide [SupportedOSPlatform("windows7.0")] attribute in
         GlobalUsings.cs; EventLogWriter additionally wraps the call in
         a try/catch so a non-Windows host (or a Windows host with the
         service stopped) can't throw out of a logging call. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.7" />
  </ItemGroup>

  <!-- Localisation: the typed Strings accessor is hand-managed via
       scripts/regenerate-strings-designer.sh; Strings.resx is the
       neutral resx for the assembly's NeutralLanguage (en-GB). Fifteen
       satellite resx sit beside it (Strings.<culture>.resx for zh-Hans,
       ru, es, ja, pt-BR, pl, tr, ko, fr, it, de, id, vi, uk and nl), so
       the build emits a satellite assembly per culture and .NET resource
       fallback serves the neutral resx only for a culture with no
       satellite. Each satellite is generated from its
       gen-strings-<code>.mjs MAP; only the resx is committed. A
       sixteenth UI language lands as a new Strings.<culture>.resx
       generated the same way (Arabic is README-only and has no resx). -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <ManifestResourceName>InstallerClean.Resources.Strings</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
